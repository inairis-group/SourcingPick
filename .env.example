# Copy to .env.local for development. Never commit a real .env.
# The .env.example file is the only env-prefixed file tracked by git.
#
# For an end-to-end audit of every variable + which features it gates,
# read docs/deployment/runbook.md.

# =========================================================
# Database
# =========================================================

# Dev: matches docker-compose.yml. Prod: full Postgres connection string,
# ideally pooled via PgBouncer in transaction mode for serverless runtimes.
DATABASE_URL="postgresql://sourcingpick:sourcingpick_dev@localhost:5432/sourcingpick?schema=public"

# Optional. Used by `npm run test:integration`. If unset, the harness
# defaults to swapping the database name in DATABASE_URL to
# `sourcingpick_test`. Run `npm run db:test:setup` once before the
# first test run to create + migrate the test database.
# TEST_DATABASE_URL=""

# =========================================================
# Auth.js
# =========================================================

# Generate with `openssl rand -base64 32`. Required in every environment.
AUTH_SECRET=""

# Public origin for the canonical auth URLs (callbacks, magic links).
AUTH_URL="http://localhost:3000"   # production: https://sourcingpick.com

# OAuth providers — leave blank to disable a given provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =========================================================
# Email (Nodemailer / SMTP)
# =========================================================

# Dev: point at Mailpit (docker-compose) so OTPs / resets stay local.
# Prod: SES, Resend, Postmark, etc. — anything that accepts SMTP.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SourcingPick <no-reply@sourcingpick.local>"
# Where a human reply to a transactional mail should land. Unset, replies go
# to EMAIL_FROM and are lost. Inbound mail is not parsed back into threads
# yet, so point this at an inbox someone actually reads.
EMAIL_REPLY_TO=""

# --- PingPong (payment rail) ----------------------------------------------
# The live rail since 2026-08, replacing Stripe + Wise. Chosen for the China
# corridor: suppliers are Chinese factories, and settling to a domestic
# Chinese account is the difference between a payout landing in days and a
# supplier chasing an intermediary bank for a fortnight.
#
# Unset, payouts fail as RETRYABLE rather than failed — the money is still
# owed once the rail is live, so nothing needs manual resurrection.
#
# Webhook endpoint to register with PingPong:
#   POST https://sourcingpick.com/api/pingpong/webhook
#   header: x-pingpong-signature  (HMAC-SHA256 of the raw body)
PINGPONG_API_BASE=""             # sandbox and production differ
PINGPONG_CLIENT_ID=""
PINGPONG_CLIENT_SECRET=""
PINGPONG_WEBHOOK_SECRET=""

# --- Platform receive account (buyer wires) --------------------------------
# Bank details shown to a buyer paying by transfer, and what the reconciler
# matches incoming credits against.
PLATFORM_IBAN=""
PLATFORM_BIC=""
PLATFORM_HOLDER_NAME=""

# --- Inbound email (replies by mail) ---------------------------------------
# Lets a customer answer a support mail from their own inbox. Both must be set
# or the feature stays off and the mails point people back to the app instead.
#
# INBOUND_EMAIL_DOMAIN is the domain your provider routes to this webhook.
# Outbound mail then carries Reply-To: reply+<kind>.<id>.<sig>@<that domain>,
# and the signature is what authenticates the reply — the From header is
# forgeable and is never used for routing.
#
# Point your provider's inbound webhook at:
#   POST https://sourcingpick.com/api/inbound/email
#   Authorization: Bearer ${INBOUND_EMAIL_SECRET}
INBOUND_EMAIL_DOMAIN=""          # e.g. reply.sourcingpick.com
INBOUND_EMAIL_SECRET=""          # openssl rand -base64 32

# =========================================================
# Public origins
# =========================================================

# Used by the buyer's Wise wire panel, OAuth callbacks, password-reset
# emails, the forwarder magic-link absolute URLs, and anywhere the
# server needs to render an absolute URL.
# Absolute base for links that leave the app (emails). A relative path is
# useless in a mail client, so this MUST be the real origin in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # production: https://sourcingpick.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # production: https://sourcingpick.com

# =========================================================
# Payments — Wise Business (sole live rail)
# =========================================================

# 1. Open a Wise Business account at https://wise.com/business/.
# 2. Generate an API token at https://wise.com/your-account/integrations-and-tools/api-tokens.
# 3. Configure webhooks at https://wise.com/your-account/integrations-and-tools/webhooks —
#    add `/api/wise/webhook` with the events your finance team wants
#    (`balances#credit` is the minimum for buyer-side reconciliation).
# 4. Wise publishes an RSA public key per webhook event family — fetch
#    it from https://docs.wise.com/api-docs/features/webhooks-notifications/webhook-verification
#    and paste the PEM in WISE_WEBHOOK_PUBLIC_KEY. Multi-line: keep the
#    surrounding `-----BEGIN PUBLIC KEY-----` lines intact.
# Selects the Wise API host: "production" → api.wise.com, anything else
# (or unset) → api.wise-sandbox.com. Keep unset for dev/sandbox.

# Platform IBAN — the bank account buyers wire deposits + balances to.
# Surfaced to the buyer in the Wise Wire Panel on the order detail page.
# All three are required for the wire panel to render (it hides if any
# are missing). HOLDER_NAME is the beneficiary the buyer's bank will see.

# =========================================================
# Invoice / fapiao issuer identity (PLATFORM_*)
# =========================================================
#
# Printed verbatim on the supplier block of generated invoice PDFs
# (see lib/invoices/pdf.tsx). Each falls back to a placeholder default
# if unset, but production invoices are not legally valid without the
# real SIREN / VAT number / registered address — set them before billing.
PLATFORM_LEGAL_NAME="SourcingPick SAS"
PLATFORM_LEGAL_FORM="SAS"
PLATFORM_ADDRESS=""
PLATFORM_CITY="Paris"
PLATFORM_COUNTRY="FR"
PLATFORM_VAT_NUMBER=""
PLATFORM_SIREN=""
PLATFORM_RCS_CITY="Paris"
PLATFORM_SHARE_CAPITAL=""

# =========================================================
# AI — Anthropic (marketplace listing auto-translation)
# =========================================================
#
# Used by lib/marketplace/translation.ts to translate catalogue copy
# into the supported locales. Leave blank to disable auto-translation
# (admins then enter translations manually).
ANTHROPIC_API_KEY=""

# =========================================================
# Cron / scheduled jobs
# =========================================================

# Shared secret for /api/cron/* routes. Generate with:
#   openssl rand -hex 32
# Vercel Cron auto-sends `Authorization: Bearer ${CRON_SECRET}`. On a
# VPS, configure systemd-timer / cron to send the same header. Cron
# routes refuse to run when this is unset, so production deploys must
# set it.
CRON_SECRET=""

# =========================================================
# Observability (optional)
# =========================================================

# Healthz response surfaces this so deploys can verify which build is
# live. Set to the git SHA at build time. On Vercel / Render this is
# auto-set; on VPS deployments, your build script should pipe it in.
# BUILD_SHA=""

# =========================================================
# Retired in the Wise migration (CTO audit F8)
# =========================================================
#
# The following variables powered Stripe Connect, LianLian Global, and
# Alipay payouts. They are no longer read by any code path — Wise is
# the sole live rail. The blocks remain commented out here so older
# Vercel project copies don't fail an "unrecognised env var" lint, but
# they can be safely removed from your secrets store.
#
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# LIANLIAN_API_HOST=""
# LIANLIAN_MERCHANT_ID=""
# LIANLIAN_PRIVATE_KEY=""
# LIANLIAN_PLATFORM_PUBLIC_KEY=""
# LIANLIAN_WEBHOOK_SECRET=""
# ALIPAY_API_HOST=""
# ALIPAY_APP_ID=""
# ALIPAY_APP_PRIVATE_KEY=""
# ALIPAY_PUBLIC_KEY=""
# ALIPAY_WEBHOOK_SECRET=""

# --- 1688 integration (removable stub) -------------------------------------
# Off by default. See src/lib/integrations/vendor-1688/README.md.
# No data feed is configured yet: the fixture provider serves sample listings
# and refuses to submit orders, so enabling this shows a demo catalogue only.
VENDOR_1688_ENABLED=false
# Resale markup on supplier prices, in basis points. 1500 = 15%.
VENDOR_1688_MARKUP_BPS=1500
