# Copy to .env.local for development. Never commit a real .env.
# The .env.example file is the only env-prefixed file tracked by git.

# Database — matches docker-compose.yml
DATABASE_URL="postgresql://sourcingpick:sourcingpick_dev@localhost:5432/sourcingpick?schema=public"

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Email (Nodemailer, SMTP) — point at Mailpit / Mailhog in dev for safe testing
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SourcingPick <no-reply@sourcingpick.local>"

# OAuth (Phase 1)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (Phase 3)
# 1. Grab test keys at https://dashboard.stripe.com/test/apikeys
# 2. For webhooks in local dev: install the Stripe CLI and run
#      stripe listen --forward-to localhost:3000/api/stripe/webhook
#    The CLI prints a `whsec_...` value to put in STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# LianLian Global (cross-border payouts to mainland China + SE Asia)
# 1. Apply for a merchant account at https://global.lianlianpay.com — once
#    approved you'll get a merchant ID and a portal to upload your RSA
#    public key in exchange for theirs.
# 2. LIANLIAN_PRIVATE_KEY is the multi-line PEM you generated (keep the
#    matching public key uploaded to their portal).
# 3. LIANLIAN_PLATFORM_PUBLIC_KEY is the PEM LianLian publishes for you to
#    verify their response signatures.
# 4. LIANLIAN_API_HOST: https://api.lianlianpay-inc.com (sandbox host
#    differs — check their docs for current sandbox URL).
LIANLIAN_API_HOST=""
LIANLIAN_MERCHANT_ID=""
LIANLIAN_PRIVATE_KEY=""
LIANLIAN_PLATFORM_PUBLIC_KEY=""
LIANLIAN_WEBHOOK_SECRET=""

# Alipay (Ant International) cross-border payouts
# 1. Open an Ant International merchant account at https://global.alipay.com
#    and create an app — they issue an APP_ID.
# 2. Generate an RSA2 keypair (SHA256withRSA); upload the public key to
#    the app portal, keep the private key in ALIPAY_APP_PRIVATE_KEY as a
#    multi-line PEM.
# 3. ALIPAY_PUBLIC_KEY is the PEM Alipay publishes for signature
#    verification of their responses and webhooks.
# 4. ALIPAY_API_HOST: https://openapi.alipay.com/gateway.do (production)
#    or https://openapi-sandbox.dl.alipaydev.com/gateway.do (sandbox).
ALIPAY_API_HOST=""
ALIPAY_APP_ID=""
ALIPAY_APP_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_WEBHOOK_SECRET=""

# Public site (used for Stripe Checkout redirect URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cron — shared secret for /api/cron/* routes. Generate with:
#   openssl rand -hex 32
# Vercel Cron auto-sends `Authorization: Bearer ${CRON_SECRET}`. On a VPS,
# configure your scheduler to send the same header. Routes refuse to run
# when this env is unset, so production deploys must set it.
CRON_SECRET=""
