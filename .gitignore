# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/uploads

# Large downloadable assets are served by nginx from /var/www/sourcingpick-assets,
# not committed. Git keeps every version of a binary forever, so a 76 MB
# catalogue would quintuple the repo permanently — and everyone who ever clones
# it would pay for that, including after the file is replaced.
# See docs/brand/assets.md.
/public/catalogue_*.pdf
