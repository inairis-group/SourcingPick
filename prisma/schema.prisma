enum MarketplaceCondition {
  NEW
  USED
  REFURBISHED
}

/// Display preference for production lead time on MarketplaceProduct. The
/// underlying `leadTimeDays` column always stores canonical DAYS (so order
/// ETAs, filters, and ranking stay simple) — this only controls how the
/// factory entered the value and how we render it back (e.g. 60 days → "2
/// months"). Conversion lives in src/lib/marketplace/lead-time.ts.
enum LeadTimeUnit {
  DAY
  MONTH
}

/**
 * Pricing-v3 Phase 3 — approximate delivery-fee bracket per route.
 * Keyed by (originCountry, destinationCountry, incoterm, weightBracket).
 * The bracket field is an INT representing kg (one row per 10 kg
 * bracket up to a cap — e.g. 0, 10, 20, 50, 100, 250, 500, 1000).
 * estimateDeliveryFee() finds the bracket that brackets the actual
 * weight and returns the row's min/max range.
 * Numbers are intentionally rough — we tell buyers they're estimates.
 * Real quotes still go through the logistics partner of record at
 * tender time. Rates can be edited by an admin from the (future)
 * /admin/delivery-rates page.
 */
model DeliveryRate {
  id                 String   @id @default(cuid(2))
  originCountry      String // ISO 3166-1 alpha-2 (e.g. "CN")
  destinationCountry String // ISO 3166-1 alpha-2 (e.g. "FR")
  incoterm           Incoterm
  /// Inclusive lower bound of the weight bracket in kg.
  weightBracketKg    Int
  /// Lower estimate of the all-in delivery fee, in cents.
  minCents           Int
  /// Upper estimate of the all-in delivery fee, in cents.
  maxCents           Int
  /// Display-only label for the logistics partner shown alongside
  /// the estimate (e.g. "DHL Global Forwarding", "Maersk LCL").
  partnerName        String
  /// Optional notes (e.g. "transit ~22d", "customs not included").
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([originCountry, destinationCountry, incoterm, weightBracketKg])
  @@index([originCountry, destinationCountry])
}

enum AttachmentContext {
  /// Pro forma invoices, spec sheets and photos attached to a quote asked for
  /// from the public site. The uploader is nobody — a visitor has no account —
  /// so these are readable by the internal team only.
  QUOTE_REQUEST
  MESSAGE
  SOURCING_REQUEST
  /// §2.2.1 — the order invoice handed to the expéditeur. One invoice may
  /// cover several products of the same order ("regroupement multi-produits
  /// autorisé"), so this is one attachment per Shipment, not per item.
  SHIPMENT_INVOICE
  /// §2.1.1 — per-product photo supplied with the brief.
  SHIPMENT_ITEM_IMAGE
  ORDER
  MARKETPLACE_PRODUCT
  MARKETPLACE_BANNER
  /// Factory uploads while order is in QC — photos of the finished
  /// product, packed cartons, labels. Buyer can review before the
  /// factory ships.
  ORDER_QC_PROOF
  /// Factory uploads at handoff — photos of the package handed to the
  /// carrier with a visible tracking label. Closes the "did it ship?"
  /// ambiguity loop on disputes.
  ORDER_SHIPMENT_PROOF
  /// Buyer- or factory-uploaded evidence on a Dispute (photos of the
  /// damaged goods, side-by-side comparisons, packing slips, etc.).
  /// Admin arbitrates with these visible in the dispute detail page.
  DISPUTE_EVIDENCE
  /// Admin-recorded short video (mp4/webm) of a marketplace product
  /// being tested — used to justify the tested-and-approved gate
  /// during the "marketplace de-emphasis" phase. Single video per
  /// listing; replaces any previous one. Shown on the public product
  /// page as a "Product test" section once the listing is approved.
  MARKETPLACE_TEST_VIDEO
}

/**
 * Preset visual treatment for an admin-managed marketplace campaign banner.
 */
enum BannerTone {
  BRAND // brand-blue gradient
  DARK // ink-deep, matches the CTA banner
  SALE // danger/red accent for flash-sale campaigns
}

/**
 * How a banner's background is rendered.
 * PRESET   — one of the BannerTone gradients (default, no config)
 * GRADIENT — admin-defined linear gradient (from/via?/to + angle)
 * IMAGE    — uploaded image, with a dark overlay for text legibility
 * VIDEO    — uploaded muted-autoplay-loop video, with overlay
 */
enum BannerBackground {
  PRESET
  GRADIENT
  IMAGE
  VIDEO
}

/// Auction lifecycle. Factories can list bulk lots / clearance stock for
/// buyers to bid on; the highest bid at endsAt wins and an Order is
/// created at that price. Commission curve for auctions is separate from
/// the 6%/3% sourcing commission — see docs/pricing-auctions.md.
enum AuctionStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  ACTIVE
  ENDED
  SOLD
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WINNING
  REJECTED
}

enum AttachmentKind {
  IMAGE
  VIDEO
  /// Voice notes recorded in the messaging UI (partner feedback #9). Same
  /// storage path as other attachments; size cap lives in
  /// lib/storage/attachments.ts.
  AUDIO
  FILE
}

/**
 * Payout provider a factory or agent has onboarded with.
 * STRIPE_CONNECT — default for the EU/US/UK/SG/HK/UAE/MX/JP/AU/NZ
 * footprint plus parts of Africa (ZA, NG, KE, etc.).
 * LIANLIAN       — cross-border payouts to mainland China + SE Asia.
 * ALIPAY         — Alipay Cross-border / Ant International, also for
 * mainland China factories that prefer Alipay over
 * LianLian's bank-account flow.
 * Locked once chosen (changing mid-relationship invalidates prior
 * payout audit references). Each provider has its own credential set
 * in env and its own KYC flow; see lib/payouts/* for adapters.
 */
/// Live rail = WISE only (decided 2026-06-02). The Stripe / LianLian /
/// Alipay values were pruned in the CTO-audit follow-up migration
/// (20260605100000_drop_deprecated_enum_values). Any orgs still
/// pointing at the legacy rails were back-migrated to NULL — they need
/// to onboard Wise before payouts can resume.
enum PayoutProvider {
  /// PingPong — the rail as of 2026-08. Chosen for China: our suppliers are
  /// Chinese factories, and a rail that settles to a domestic Chinese account
  /// is the difference between a payout landing in two days and a supplier
  /// chasing an intermediary bank for a fortnight.
  PINGPONG
  /// @deprecated — removed 2026-08. Retained because Payout and
  /// EscrowTransaction rows reference it and financial records are immutable.
  WISE
}

/**
 * Per-provider onboarding/account state on a factory or agent org. We
 * track this separately from Organization.kycStatus because payout
 * providers run their *own* KYB/AML — being verified by us doesn't
 * mean Stripe/LianLian/Alipay accepted the account.
 */
enum PayoutAccountStatus {
  NONE // No provider chosen / no account opened
  PENDING // Provider onboarding started, awaiting provider verification
  ACTIVE // Account verified and can receive payouts
  RESTRICTED // Provider returned a restriction (missing docs, suspended)
  REJECTED // Provider permanently refused
}

enum InvoiceType {
  DEPOSIT
  BALANCE
  // Sourcing-flow research fee — billed per qualified request, credited back if order placed within 30 days.
  RESEARCH_FEE
  // Legacy from spec §1.1 (sourcing-side commission). Kept until commission wiring lands in Phase 3.
  SOURCING_FEE
  CERT_FEE
  /// Freight, quoted by the shipper and accepted by the buyer. Deliberately
  /// its own line rather than folded into BALANCE: customs and accounting
  /// both need goods and freight separated, and a dispute about a late
  /// delivery must not put the payment for the goods in dispute with it.
  SHIPPING
  /// Partner round 4 — admin-issued ad-hoc invoice. Used for one-off
  /// billing the standard order/research/cert paths don't cover
  /// (commission true-ups, manual platform fees, bespoke services).
  /// The cents amount, line description, and direction (to client /
  /// factory / agent) are all set by the admin at create time.
  ADMIN_CUSTOM
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum EscrowStatus {
  INITIATED
  FUNDED
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum EscrowReleaseTrigger {
  DELIVERY_CONFIRMED
  ADMIN_OVERRIDE
  AUTO_TIMEOUT
}

/// Same deprecation as PayoutProvider — only WISE is written today.
/// SEPA / SWIFT remain valid (they're rail-method labels Wise can resolve
/// to under the hood). STRIPE_CONNECT / LIANLIAN / ALIPAY are dead.
enum PayoutMethod {
  SEPA
  SWIFT
  /// @deprecated — see PayoutProvider.
  STRIPE_CONNECT
  /// @deprecated — see PayoutProvider.
  LIANLIAN
  /// @deprecated — see PayoutProvider.
  ALIPAY
  /// @deprecated — see PayoutProvider.
  WISE
  /// Domestic Chinese bank transfer via PingPong.
  PINGPONG
}

/**
 * Billing unit for the sourcing research fee (€125/day or €500/week).
 */
enum ResearchFeeUnit {
  DAY
  WEEK
}

/**
 * Why a CreditTransaction was written.
 * RESEARCH_FEE_CREDIT — buyer ordered within the credit-back window; the
 * research fee they paid is returned as credit (+).
 * ORDER_APPLIED       — credit spent against an order payment (−).
 * ADMIN_ADJUSTMENT    — manual ops correction (±).
 */
enum CreditReason {
  RESEARCH_FEE_CREDIT
  /// Issued when admin refunds a paid research fee because the agent
  /// failed to produce a result within the agreed timeframe. Same
  /// cents amount as RESEARCH_FEE_CREDIT, different reason so finance
  /// reports can split "credit because order placed" vs "credit
  /// because no result delivered" cleanly.
  RESEARCH_FEE_REFUND
  ORDER_APPLIED
  ADMIN_ADJUSTMENT
}

/**
 * Lifecycle of a request's research fee.
 * NONE     — no fee quoted yet
 * QUOTED   — agent set the fee; an ISSUED invoice awaits payment
 * PAID     — buyer paid the research fee
 * CREDITED — buyer placed an order within the credit-back window; the fee
 * was returned as platform credit (credit-back phase — TBD)
 * WAIVED   — agent/admin waived the fee
 */
enum ResearchFeeStatus {
  NONE
  QUOTED
  PAID
  CREDITED
  WAIVED
  /// Admin issued a no-result refund — fee credited back as platform
  /// credit because the agent didn't deliver a matching quote within
  /// the agreed timeframe. Distinct from CREDITED (which fires
  /// automatically when an order completes within the credit-back
  /// window) so finance can tell the two apart in reports.
  REFUNDED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  SENT
  RECEIVED
  FAILED
}

enum CertificationBody {
  BUREAU_VERITAS
  AFNOR
  SGS
  LNE
}

enum CertificationStatus {
  DOSSIER
  AUDIT_PROGRAMME
  EN_COURS
  CERTIFIE
  REFUSE
}

enum ThreadContextType {
  REQUEST
  TENDER
  QUOTE
  ORDER
  CERT
  KYC
  DISPUTE
  /// Direct conversation between two parties (e.g. a buyer and an agent)
  /// not anchored to any specific entity. Powers the standalone /messages
  /// tab — partner feedback #9. v1 scaffold; UI lands in a follow-up.
  DIRECT
  /// Support ticket — standalone thread between a requester (client,
  /// factory or agent) and the admin/support team. Linked to a
  /// `SupportTicket` row that carries status (PENDING/OPEN/RESOLVED) and
  /// an optional polymorphic topic (order, product, org, agent).
  SUPPORT
}

enum SupportTicketStatus {
  /// Created by the requester, no admin response yet.
  PENDING
  /// An admin has engaged or explicitly opened it.
  OPEN
  /// Admin marked it resolved. A new requester message reopens it.
  RESOLVED
}

/// Polymorphic anchor for a SupportTicket. The admin picks one of these
/// after the conversation starts to give the ticket structure (links to
/// the relevant order, listing, factory profile, etc.). `topicId` is the
/// id of the row in the corresponding table — left as a plain string so
/// the SupportTicket survives when an upstream row is soft-deleted.
enum SupportTopicKind {
  ORDER
  SOURCING_REQUEST
  MARKETPLACE_PRODUCT
  AUCTION
  /// Organization with type=CLIENT.
  CLIENT_ORG
  /// Organization with type=FACTORY.
  FACTORY_ORG
  /// User with role=AGENT.
  AGENT
}

enum NotificationType {
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  PAYMENT_RECEIVED
  SHIPMENT
  INVOICE_DUE
  CERT_UPDATE
  KYC_DECISION
  MESSAGE_MENTION
  /// The team answered a support ticket. Emailed rather than in-app only:
  /// the requester may have raised it from the public chat widget and has no
  /// reason to be logged in waiting for it.
  SUPPORT_REPLY
  /// Shipper submitted or revised a logistics quote (fixed price + validity).
  SHIPMENT_QUOTE
  /// Shipment moved to a new status in the 10-step lifecycle.
  SHIPMENT_STATUS
  /// Shipper reported an incident: delay, blockage, surcharge, customs.
  SHIPMENT_INCIDENT
  SYSTEM
}

enum AuditLevel {
  INFO
  WARN
  ALERT
}

enum AgentTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum AgentTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WebhookSource {
  PINGPONG
  /// @deprecated — retained so historical WebhookEvent rows stay readable.
  STRIPE
  /// Wise Business webhook deliveries — buyer wire credits + payout state
  /// transitions. Added 2026-06 (partner item #6) so the admin webhook
  /// dashboard surfaces unmatched / failed Wise reconciliations.
  WISE
  CARRIER
  OTHER
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  RETRYING
}

// KYC documents submitted by factories at signup. Reviewed by Admin in
// the KYC queue (admin/kyc).
enum KycDocumentKind {
  /// 营业执照 (yíngyè zhízhào) — the Chinese business licence. Sourcing is
  /// China-only, and this single document is what a factory needs to register:
  /// it carries the legal name, scope and the Unified Social Credit Code.
  BUSINESS_LICENSE
  /// Identity document of a company representative holding more than 25% of
  /// the capital. Not required to register — required to pass verification,
  /// which is the beneficial-owner check.
  REPRESENTATIVE_ID
  /// Legacy kinds. Kept so historical rows stay readable; no longer requested
  /// at signup. Postgres cannot drop an enum value that data may reference.
  REGISTRY // Registre du commerce / business registration certificate (required per spec §10.1)
  TAX // Certificat fiscal / tax compliance certificate (required)
  FACILITY_PHOTO // Photo of installations (required, min. 3)
  REFERENCES // List of reference clients (recommended)
  INSURANCE // Quality assurance / liability insurance (recommended for risk categories)
  OTHER // Catch-all for misc supporting docs
}

// =============================================================
// ACCOUNT AGGREGATE — User, Auth.js tables, Organization, FactoryProfile
// =============================================================

model User {
  id String @id @default(cuid(2))

  // Auth.js v5 required shape
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Domain
  firstName       String
  lastName        String
  phone           String?
  locale          Locale          @default(fr)
  /// Email delivery cadence for non-critical notifications.
  ///   IMMEDIATE — one email per event (default).
  ///   DAILY     — events accumulate in-app, one digest email per day.
  ///   OFF       — no notification emails (in-app only).
  /// Critical events (password reset, OTP) ignore this setting.
  emailDigestMode EmailDigestMode @default(IMMEDIATE)
  role            Role
  subRole         SubRole
  /// Per-admin permission scopes. Empty / irrelevant for non-admins;
  /// for admins, an empty array means "no admin powers" (effectively
  /// read-only). Use the `SUPER` sentinel to grant everything.
  adminScopes     AdminScope[]    @default([])

  // ─── Agent-specific overrides ─────────────────────────────
  // Only meaningful when role=AGENT. Null = default rates from
  // pricing.ts apply. Used by research-fee-actions when an agent
  // negotiates a higher day-rate for complex industrial briefs (the
  // €125/day floor is the platform's published rate; senior agents
  // commonly bill €200+/day).
  agentResearchFeeDayCents  Int?
  agentResearchFeeWeekCents Int?
  /// Free-text Markdown bio surfaced on the agent profile (timezone,
  /// language strengths, category specialisations). Optional.
  agentBio                  String?
  /// IANA timezone string, e.g. "Asia/Shanghai". When set, the agent's
  /// dashboard renders times in this zone instead of the buyer's.
  agentTimezone             String?
  /// Categories the agent self-declares expertise in. Used by the
  /// dispatch loader to break ties when load is equal.
  agentCategories           Category[]   @default([])
  /// Marks whether the agent has finished onboarding. Until true, they
  /// land on /onboarding/agent on every login.
  agentOnboardedAt          DateTime?
  /// Partner #16: tracks whether the buyer has dismissed the first-
  /// order tutorial (a guided coachmark series on the client dashboard
  /// + new-request wizard). Null = tutorial still shown. Stamped on
  /// dismiss. Only meaningful for CLIENT users.
  clientTutorialDismissedAt DateTime?
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  passwordHash              String? // null when only OAuth
  hasOnboarded              Boolean      @default(false)
  twoFactorEnabled          Boolean      @default(false)
  lastSeenAt                DateTime?
  deletedAt                 DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  // Auth.js relations
  accounts  Account[]
  sessions  Session[]
  emailOtps EmailOtp[]

  attachments Attachment[]

  // Domain relations
  sourcingRequestsCreated   SourcingRequest[]        @relation("RequestCreatedBy")
  agentForRequests          SourcingRequest[]        @relation("RequestAgent")
  preTenderApprovals        SourcingRequest[]        @relation("PreTenderApprover")
  forwarderTokensCreated    ForwarderUploadToken[]   @relation("ForwarderTokenCreator")
  supportTicketsOpened      SupportTicket[]          @relation("SupportTicketRequester")
  supportTicketsResolved    SupportTicket[]          @relation("SupportTicketResolver")
  disputesOpened            Dispute[]                @relation("DisputeOpener")
  disputesResolved          Dispute[]                @relation("DisputeResolver")
  invoicesIssued            Invoice[]                @relation("InvoiceIssuer")
  marketplaceTestedProducts MarketplaceProduct[]     @relation("MarketplaceProductTester")
  quotesAsAgent             Quote[]                  @relation("QuoteAgent")
  ordersAsAgent             Order[]                  @relation("OrderAgent")
  shipmentEvents            ShipmentEvent[]          @relation("ShipmentEventActor")
  orderStageEvents          OrderStageEvent[]        @relation("OrderStageActor")
  shipmentQuotes            ShipmentQuote[]          @relation("ShipmentQuoteAuthor")
  marketplaceReviews        MarketplaceReview[]      @relation("ReviewAuthorUser")
  authoredMessages          Message[]                @relation("MessageAuthor")
  threadParticipations      ThreadParticipant[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  assignedTasks             AgentTask[]              @relation("TaskAgent")
  placedBids                Bid[]                    @relation("BidderUser")
  deletionRequests          AccountDeletionRequest[] @relation("DeletionRequester")
  deletionRequestsReviewed  AccountDeletionRequest[] @relation("DeletionReviewer")
  guestConversations        GuestConversation[]      @relation("GuestChatLinkedUser")
  quoteRequests             QuoteRequest[]           @relation("QuoteRequestLinkedUser")

  @@index([organizationId])
  @@index([role, deletedAt])
}

// Auth.js — OAuth provider account links
model Account {
  id                String  @id @default(cuid(2))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js — DB session strategy
model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// Auth.js — used for password reset tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Our 2FA email-OTP records — not Auth.js
model EmailOtp {
  id         String    @id @default(cuid(2))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String // bcrypt of the 6-digit code
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Organization {
  id                      String    @id @default(cuid(2))
  type                    OrgType
  legalName               String
  displayName             String
  country                 String
  city                    String
  address                 String
  vatNumber               String?
  siren                   String? // FR only
  /// 统一社会信用代码 (Tongyi Shehui Xinyong Daima) — Unified Social Credit
  /// Code. The single primary identifier for a Chinese legal entity: 18
  /// characters, printed on the 营业执照, and what replaces SIREN/VAT for the
  /// factories we onboard. Nullable because non-Chinese orgs (clients,
  /// platform) don't have one.
  unifiedSocialCreditCode String?
  /// Stored relative path to the org's logo image (factories surface this
  /// on storefront/marketplace cards, clients on invoice headers). Null
  /// until the org uploads one — UI falls back to initials.
  logoUrl                 String?
  /// Public-web links surfaced on the KYC review screen so admin can
  /// cross-check that the entity behind the account matches what's on
  /// their public footprint. Partner #28. Free-form URLs (the form
  /// trims and validates) — empty string = not supplied.
  websiteUrl              String?
  instagramUrl            String?
  facebookUrl             String?
  linkedinUrl             String?
  kycStatus               KycStatus @default(PENDING)
  /// Partner round 4 — set true when the org was created by an agent
  /// on behalf of an off-platform factory (typically a Chinese factory
  /// the agent has negotiated with by phone / WeChat / email and that
  /// doesn't have a SourcingPick account yet). KYC stays PENDING; the
  /// only fields populated are the bare minimum (displayName, country,
  /// city). The agent can later invite the real factory to claim it
  /// via an onboarding link, after which `isShadowOrg` flips back to
  /// false and the regular KYC flow runs.
  isShadowOrg             Boolean   @default(false)
  kycVerifiedAt           DateTime?
  suspended               Boolean   @default(false)
  // Stripe identifiers — populated lazily on first checkout / first onboarding.
  // stripeCustomerId is used for clients (deposits + balance payments).
  // stripeConnectAccountId is used for factories (Connect Express payouts).
  stripeCustomerId        String?
  stripeConnectAccountId  String?

  // Wise recipient account ID — the ID Wise issues after the platform
  // registers a factory's bank details via POST /v1/accounts. Used to
  // address payouts in `lib/payouts/wise.ts`. Null until the factory has
  // completed bank-details onboarding. Will replace the Stripe fields
  // above once the Wise migration retires Stripe.
  wiseRecipientId String?

  // Payouts — which provider this org has chosen (factories + agents).
  // Locked once `payoutOnboardedAt` is set: changing provider mid-relationship
  // invalidates audit references on already-paid orders. The provider-specific
  // ID lives in `payoutAccountId` (Stripe acct_..., LianLian payee id, Alipay
  // login id) and is interpreted by the adapter in `lib/payouts/<provider>.ts`.
  payoutProvider    PayoutProvider?
  payoutAccountId   String?
  payoutStatus      PayoutAccountStatus @default(NONE)
  payoutOnboardedAt DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users          User[]
  factoryProfile FactoryProfile?

  clientSourcingRequests SourcingRequest[]  @relation("RequestClientOrg")
  factoryQuotes          Quote[]            @relation("QuoteFactoryOrg")
  factoryTenderInvites   TenderInvitation[] @relation("TenderFactoryOrg")

  clientOrders  Order[] @relation("OrderClientOrg")
  factoryOrders Order[] @relation("OrderFactoryOrg")

  factoryAuctions Auction[] @relation("AuctionFactoryOrg")
  bids            Bid[]     @relation("BidderOrg")

  marketplaceProducts MarketplaceProduct[]

  invoices Invoice[]
  payouts  Payout[]

  supportTicketsOpened SupportTicket[] @relation("SupportTicketRequesterOrg")

  factoryCertifications     Certification[] @relation("CertFactoryOrg")
  sponsorshipCertifications Certification[] @relation("CertSponsorOrg")

  kycDocuments KycDocument[]

  creditTransactions CreditTransaction[]

  shipmentsAsShipper Shipment[]          @relation("ShipmentShipperOrg")
  marketplaceReviews MarketplaceReview[] @relation("ReviewAuthorOrg")

  payoutsReceived Payout[] @relation("PayoutPayeeOrg")

  @@index([type, kycStatus, deletedAt])
  @@index([type, country])
}

/**
 * Platform-credit ledger. An org's balance is the SUM of amountCents across
 * its rows (positive = credit granted, negative = credit spent). No
 * denormalised balance column — the ledger is the source of truth, summed
 * on read. Today's only credit source is the research-fee credit-back;
 * the only sink is applying credit to an order's deposit.
 */
model CreditTransaction {
  id              String       @id @default(cuid(2))
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountCents     Int // signed: + granted, − spent
  reason          CreditReason
  /// Optional pointer to what triggered it (e.g. "Order:ord_..", "SourcingRequest:req_..").
  refType         String?
  refId           String?
  note            String?
  createdByUserId String?
  createdAt       DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model KycDocument {
  id             String          @id @default(cuid(2))
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           KycDocumentKind
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageUrl     String // for v1 local dev: relative path under ./uploads/; later: R2/S3 URL
  uploadedAt     DateTime        @default(now())

  @@index([organizationId, kind])
}

model FactoryProfile {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category
  foundedYear    Int?
  employees      Int?
  capabilities   String[]
  languages      String[]
  rating         Float        @default(0)
  totalOrders    Int          @default(0)
  iban           String? // encrypted at app layer
  bic            String?
  // High-level cert names for filtering; structured certs live in Certification
  certifications String[]

  @@index([category, rating])
}

// =============================================================
// SOURCING AGGREGATE
// =============================================================

model SourcingRequest {
  id                   String                @id @default(cuid(2))
  reference            String                @unique // REQ-XXXXXX
  clientOrgId          String
  clientOrg            Organization          @relation("RequestClientOrg", fields: [clientOrgId], references: [id], onDelete: Restrict)
  createdByUserId      String
  createdBy            User                  @relation("RequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  agentId              String?
  agent                User?                 @relation("RequestAgent", fields: [agentId], references: [id], onDelete: SetNull)
  title                String
  category             Category
  quantity             Int
  budgetCents          Int?
  targetUnitPriceCents Int?
  deadline             DateTime
  /// Legacy freeform delivery address. Kept for historical rows + as a
  /// fallback when the structured fields are blank (e.g. an admin
  /// imports a brief without parsing). Partner #12 added the structured
  /// fields below — new requests populate all of them at submit time.
  deliveryAddress      String
  /// Structured delivery address — partner #12. Buyer fills these on
  /// the request wizard; the order detail page renders them; future
  /// integration with a Google / Loqate address-validation API will
  /// populate them from a single search.
  deliveryStreet       String?
  deliveryPostalCode   String?
  deliveryCity         String?
  deliveryCountry      String? // ISO 3166-1 alpha-2
  deliveryRegion       String? // optional state / province
  incoterm             Incoterm
  sourcingRegion       SourcingRegion
  requiredCerts        String[]
  // ISO 3166-1 alpha-2 country code. Defaults to CN — China is the
  // current sole sourcing country, but the column is here so the admin
  // allowlist can expand the wizard's options without another migration.
  sourcingCountry      String                @default("CN")
  origin               SourcingRequestOrigin @default(SOURCING_FLOW)
  status               SourcingStatus        @default(DRAFT)
  assignedAt           DateTime?

  // Pre-tender validation gate (partner item #14). Agents cannot dispatch
  // TenderInvitations until an admin has approved the request, confirming
  // the brief is clear, the budget is sane, and the sourcing region is
  // allowed. A null `preTenderApprovedAt` is the block; rejection clears
  // approval and records the reason so the agent knows what to fix.
  preTenderApprovedAt      DateTime?
  preTenderApprovedById    String?
  preTenderApprovedBy      User?     @relation("PreTenderApprover", fields: [preTenderApprovedById], references: [id], onDelete: SetNull)
  preTenderRejectedAt      DateTime?
  preTenderRejectionReason String?

  // Research fee — agent quotes a per-day/week fee on a qualified request.
  // researchFeeInvoiceId links the issued RESEARCH_FEE invoice. Credit-back
  // (returning the fee as platform credit on order within 30 days) is a
  // later phase and not yet wired.
  researchFeeUnit      ResearchFeeUnit?
  researchFeeQuantity  Int?
  researchFeeCents     Int?
  researchFeeStatus    ResearchFeeStatus @default(NONE)
  researchFeeInvoiceId String?
  researchFeePaidAt    DateTime? // anchors the 30-day credit-back window

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          SourcingProduct[]
  tenderInvitations TenderInvitation[]
  quotes            Quote[]
  orders            Order[]
  agentTasks        AgentTask[]

  @@index([status, agentId])
  @@index([clientOrgId, status])
  @@index([status, createdAt])
}

model SourcingProduct {
  id               String          @id @default(cuid(2))
  requestId        String
  request          SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  quantity         Int
  targetPriceCents Int?
  images           String[]

  @@index([requestId])
}

model TenderInvitation {
  id            String                 @id @default(cuid(2))
  requestId     String
  request       SourcingRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  factoryOrgId  String
  factoryOrg    Organization           @relation("TenderFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  matchingScore Int // 0-100
  status        TenderInvitationStatus @default(INVITED)
  invitedAt     DateTime               @default(now())
  viewedAt      DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime

  @@unique([requestId, factoryOrgId])
  @@index([factoryOrgId, status])
  @@index([requestId, status])
}

model Quote {
  id                    String          @id @default(cuid(2))
  requestId             String
  request               SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  factoryOrgId          String
  factoryOrg            Organization    @relation("QuoteFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  agentId               String?
  agent                 User?           @relation("QuoteAgent", fields: [agentId], references: [id], onDelete: SetNull)
  unitPriceCentsFactory Int // private to platform
  marginCents           Int // private to platform
  unitPriceCentsClient  Int
  totalCentsClient      Int
  quantity              Int
  leadTimeDays          Int
  /// Display unit for the lead time the factory entered. Storage stays
  /// canonical days; this drives how we render + how the form pre-fills
  /// on edit. Same shape as MarketplaceProduct.leadTimeUnit.
  leadTimeUnit          LeadTimeUnit    @default(DAY)
  moq                   Int
  incoterm              Incoterm
  validUntil            DateTime
  qualificationScore    Int // 0-100
  /// Deposit the factory wants up front, in basis points (3000=30%, 5000=50%).
  /// Range enforced in tender-actions.ts. Marketplace direct-buy quotes
  /// default to 3000 (30%) since there's no negotiation. Buyer pays this
  /// share via Wise on acceptance; balance settles at delivery.
  depositPercentageBps  Int             @default(3000)
  status                QuoteStatus     @default(DRAFT)
  notes                 String?
  /// Partner round 4 — "relance". When the quote has been forwarded
  /// to the client (status=SENT_TO_CLIENT) and the buyer hasn't
  /// actioned it after N business days, a reminder cron stamps this
  /// timestamp and emits a notification to buyer + agent. Null means
  /// no reminder has been sent yet. We only ever send one per quote
  /// to avoid pestering — if the buyer still hasn't acted after the
  /// reminder, the agent picks up the phone.
  relancedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order Order?

  @@index([requestId, status])
  @@index([factoryOrgId, status])
  @@index([status, validUntil])
}

/// The 2026-09 SaaS canvas's order lifecycle — `SaaS-Flux-etats`.
///
/// Ten main states. These mostly restate `SourcingStatus`, which stays where
/// it is: rewriting the enum eleven models depend on would be a migration
/// with nothing to show for it. What is new is `PAYMENT_RECEIVED`, which the
/// old model ran together with preparation, and the sub-state layer below.
///
/// Mirrored in src/lib/orders/lifecycle.ts, which holds the tones, the
/// visibility rules and the allowed transitions. A test asserts the two
/// agree.
enum OrderState {
  REQUEST_RECEIVED
  AGENT_ASSIGNED
  QUOTE_SENT
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  PREPARATION_COMPLETE
  SHIPPED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

/// The thirty-nine sub-states the canvas hangs off those ten.
///
/// This is where the product actually lives. "In transit" tells a client
/// nothing; "arrived at port" tells them when to expect the lorry. Five of
/// them are internal — the canvas annotates them "Interne, non visible par le
/// client" — and collapse to their parent when a client is looking.
enum OrderStage {
  RECEIVED
  QUALIFYING
  INFO_MISSING
  AGENT_ASSIGNED
  SOURCING
  SUPPLIERS_CONTACTED
  SUPPLIER_OFFER_RECEIVED
  QUOTE_SENT
  QUOTE_VIEWED
  QUOTE_SIGNED
  QUOTE_DECLINED
  QUOTE_EXPIRED
  DEPOSIT_INVOICE_ISSUED
  TRANSFER_DECLARED
  AWAITING_FUNDS
  PARTIAL_PAYMENT
  DEPOSIT_RECEIVED
  ORDER_PLACED_WITH_SUPPLIER
  PRODUCTION
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  INSPECTING
  ISSUE_REPORTED
  INSPECTION_PASSED
  CONSOLIDATION
  READY_TO_LOAD
  BALANCE_PAID
  CONTAINER_LOADED
  EXPORT_DOCS_ISSUED
  BOOKING_CONFIRMED
  AT_SEA
  TRANSHIPMENT
  ARRIVED_AT_PORT
  CUSTOMS_CLEARANCE
  GOODS_DELIVERED
  FILE_CLOSED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_SOURCINGPICK
  REFUND_ISSUED
}

model Order {
  id                   String              @id @default(cuid(2))
  reference            String              @unique // ORD-XXXXX
  quoteId              String              @unique
  quote                Quote               @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  requestId            String
  request              SourcingRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  clientOrgId          String
  clientOrg            Organization        @relation("OrderClientOrg", fields: [clientOrgId], references: [id], onDelete: Restrict)
  factoryOrgId         String
  factoryOrg           Organization        @relation("OrderFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  agentId              String?
  agent                User?               @relation("OrderAgent", fields: [agentId], references: [id], onDelete: SetNull)
  totalCents           Int
  depositCents         Int // 30% default
  balanceCents         Int // 70% default
  commissionCents      Int // platform margin — private
  /// Partner #31: true when this order materialised from a sample-buy
  /// flow (single unit, sample price). Drives a "Sample" badge in the
  /// buyer + factory UIs and lets analytics distinguish sample orders
  /// from bulk in aggregates.
  isSample             Boolean             @default(false)
  /// Pricing-v3 Phase 4 — category-specific insurance covers the
  /// transaction at no extra cost. Defaults true for v1 (every order
  /// is covered). Admin can flip it off per-order later for
  /// restricted-goods categories where insurance can't be bound
  /// (firearms, large-volume liquids, etc.). Surfaced as an
  /// "Insured" badge on the buyer order page, on the quote PDF, and
  /// in confirmation emails.
  insuranceCovered     Boolean             @default(true)
  status               OrderStatus         @default(PAYMENT_PENDING)
  estimatedEta         DateTime?
  shippedAt            DateTime?
  /// Set when the buyer confirms physical receipt of the goods. Separate
  /// from `balancePaidAt` — both must be set for COMPLETED to be reached
  /// (CTO audit F1b). When the buyer confirms before paying the balance,
  /// this is recorded but the status stays at SHIPPED / IN_TRANSIT until
  /// the balance settles.
  deliveredAt          DateTime?
  /// Set by the payment finaliser when the balance wire / charge has
  /// reconciled. Together with `deliveredAt`, gates the transition into
  /// COMPLETED + factory payout (CTO audit F1b / F1c). Buyer-initiated
  /// COMPLETED is blocked while this is null.
  balancePaidAt        DateTime?
  /// Marketplace purchases of a listing that has variants record which one
  /// was bought. SetNull rather than Restrict: a factory retiring an option
  /// must not be blocked by an order from last year, and the human-readable
  /// record survives in the synthetic request's title either way.
  marketplaceVariantId String?
  marketplaceVariant   MarketplaceVariant? @relation("OrderVariant", fields: [marketplaceVariantId], references: [id], onDelete: SetNull)
  trackingNumber       String?
  trackingCarrier      String?
  /// Logistics leg handled by an Expéditeur Sourcing Pick. Optional: only
  /// orders routed through the shipper role have one.
  shipment             Shipment?
  marketplaceReviews   MarketplaceReview[] @relation("ReviewOrder")
  trackingUrl          String?
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  /// Where the order is, in the canvas's vocabulary. Nullable while the
  /// lifecycle is being adopted: an order created before this existed has no
  /// honest answer, and inventing one would put a fabricated history in front
  /// of a client. `stage` may be null on its own — a state with no sub-state
  /// yet is a legitimate position.
  state  OrderState?
  stage  OrderStage?

  invoices        Invoice[]
  escrows         EscrowTransaction[]
  forwarderTokens ForwarderUploadToken[]
  disputes        Dispute[]
  stageEvents     OrderStageEvent[]

  @@index([state, clientOrgId])
  @@index([status, factoryOrgId])
  @@index([status, clientOrgId])
  @@index([status, createdAt])
}

/// One step in an order's life.
///
/// The canvas draws a timeline on the client's order page and on the agent's
/// and administrator's status screens, and the application had nowhere to
/// read one from — `Order.status` was a single value with no history behind
/// it. Every change writes a row here.
///
/// This is not the audit log. `AuditLog` records that a person did something,
/// for people who investigate; this records that an order reached a point,
/// for the people waiting on it. They answer different questions and one
/// cannot be derived from the other.
model OrderStageEvent {
  id      String @id @default(cuid(2))
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  state OrderState
  /// Null when a state was entered without a sub-state being chosen.
  stage OrderStage?

  /// Denormalised from `lifecycle.ts` at write time rather than joined at
  /// read time. A sub-state's visibility is a property of the canvas, and if
  /// it were ever reclassified we would still owe the client the version of
  /// the timeline they were actually shown — not a retroactively edited one.
  clientVisible Boolean

  /// The note the agent writes for the client. `SaaS-Admin-Statut` draws it
  /// as "Commentaire pour le client", optional, beside a publish button.
  comment String? @db.Text

  /// Who moved it. Null for transitions a job made — an expiring quotation,
  /// a reconciled payment.
  actorId String?
  actor   User?   @relation("OrderStageActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// The client's timeline is this index: one order, only what they may see,
  /// newest last.
  @@index([orderId, clientVisible, createdAt])
  @@index([orderId, createdAt])
}

/**
 * Magic-link token (partner item #15) — a factory generates one of these
 * for an Order and shares the resulting URL with its forwarder/logistics
 * partner. The forwarder lands on /forwarder/upload/<token>, sees the
 * order summary (no SourcingPick account required) and uploads handoff
 * photos that land as ORDER_SHIPMENT_PROOF attachments.
 * Tokens are one-use-per-upload but live for `expiresAt`, so the
 * forwarder can come back to add more photos in the same window. Set
 * `revokedAt` to kill access early. `lastUsedAt` is bumped on every
 * successful upload for the operator log.
 */
model ForwarderUploadToken {
  id              String    @id @default(cuid(2))
  token           String    @unique // 32 hex chars — used in the magic URL
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?     @relation("ForwarderTokenCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Free-text label the factory chose ("DHL pickup", "Maersk container"). Surfaced to the forwarder.
  label           String?
  expiresAt       DateTime
  lastUsedAt      DateTime?
  uploadCount     Int       @default(0)
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([orderId, revokedAt])
  @@index([expiresAt])
}

/**
 * Buyer-initiated post-delivery dispute. The schema flow:
 * buyer opens (within 7 days of deliveredAt)
 * → factory responds (within 5 days, defaults to silence)
 * → admin arbitrates, picks an outcome:
 * STANDARD — partial refund (buyer gets back the dispute math
 * from `computeDisputeRefund`)
 * CUSTOM   — full refund (the product can't be resold)
 * REJECT   — dispute not upheld, escrow flips back to HELD
 * One open dispute per order. A REJECT-resolved dispute lets the buyer
 * open another one — closing one but not the escrow status restores
 * the original release path.
 * Evidence attachments live in the polymorphic Attachment table with
 * `contextType=DISPUTE_EVIDENCE`, `contextId=this.id`.
 */
model Dispute {
  id              String             @id @default(cuid(2))
  reference       String             @unique // DSP-XXXXX
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Primary escrow being disputed. Set when the dispute is opened
  /// against a specific escrow leg (deposit / balance); null when the
  /// dispute is whole-order (admin re-attributes the escrow at resolve
  /// time).
  primaryEscrowId String?
  primaryEscrow   EscrowTransaction? @relation(fields: [primaryEscrowId], references: [id], onDelete: SetNull)

  openedByUserId   String
  openedBy         User    @relation("DisputeOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  /// Free-text buyer claim — what's wrong, what they want.
  buyerStatement   String
  /// Optional factory rebuttal. Defaults to null when the factory
  /// stays silent past the 5-day window; admin can still arbitrate.
  factoryStatement String?
  /// Admin's narrative when resolving. Surfaces to both parties.
  adminDecision    String?

  status             DisputeStatus   @default(OPEN)
  outcome            DisputeOutcome? // set when status=RESOLVED
  refundCents        Int? // computed via computeDisputeRefund
  retainedCents      Int?
  platformShareCents Int?
  supplierShareCents Int?

  openedAt     DateTime  @default(now())
  respondedAt  DateTime?
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guestConversations GuestConversation[] @relation("GuestChatDispute")

  @@index([orderId, status])
  @@index([status, openedAt])
}

enum DisputeStatus {
  /// Buyer just opened it. Factory hasn't responded yet; admin can
  /// arbitrate without waiting.
  OPEN
  /// Factory submitted a rebuttal. Admin needs to decide.
  RESPONDED
  /// Admin picked an outcome. Refund (if any) has been computed.
  RESOLVED
}

enum DisputeOutcome {
  /// Off-spec / defective goods that can be resold. Buyer refunded
  /// 80%; platform retains 20% split 50/50 with the supplier.
  STANDARD
  /// Custom/personalised goods that can't be resold. Full buyer refund.
  CUSTOM
  /// Dispute not upheld. Escrow returns to HELD; no refund.
  REJECT
}

// =============================================================
// CATALOGUE AGGREGATE
// =============================================================

model MarketplaceProduct {
  id                     String                   @id @default(cuid(2))
  reference              String                   @unique // MKT-XXX
  factoryOrgId           String
  factoryOrg             Organization             @relation(fields: [factoryOrgId], references: [id], onDelete: Restrict)
  name                   String
  category               Category
  description            String
  images                 String[]
  priceCentsClient       Int
  priceCentsFactory      Int // private
  /// Optional "was" price for strikethrough display. When set and greater
  /// than priceCentsClient, the storefront renders a discount badge.
  /// Independent of flashSaleEndsAt — used for permanent discounts on
  /// used / refurbished / clearance items.
  compareAtCents         Int?
  /// Optional flash-sale end timestamp. When in the future, the storefront
  /// renders a flash-sale badge with a countdown alongside the discount.
  /// After this passes, the listing keeps its discounted price but the
  /// urgency badge disappears — factory must update the listing to revert.
  flashSaleEndsAt        DateTime?
  condition              MarketplaceCondition     @default(NEW)
  moq                    Int
  stockAvailable         Int                      @default(0)
  /// True when the listing IS one specific physical object rather than a
  /// quantity of interchangeable ones — a used vehicle being the case that
  /// forced this. Unique listings hold stock 1 and retire on sale instead of
  /// decrementing, and they cannot carry variants: there is nothing to vary.
  isUniqueItem           Boolean                  @default(false)
  /// Denormalised rating aggregates. Kept on the row so listing cards and
  /// sort-by-rating don't need an aggregate join per card; recomputed inside
  /// the same transaction that publishes or hides a review, so they cannot
  /// drift from MarketplaceReview.
  ratingCount            Int                      @default(0)
  ratingSum              Int                      @default(0)
  stockLowThreshold      Int?
  /// Canonical lead time in DAYS — used by order ETAs, filters, ranking.
  /// The factory may have entered it in months via the UI; conversion to
  /// days happens at submit (see lib/marketplace/lead-time.ts).
  leadTimeDays           Int
  /// Display preference (DAY | MONTH). Drives the input unit on edit and
  /// the formatted output on product pages.
  leadTimeUnit           LeadTimeUnit             @default(DAY)
  certifications         String[]
  status                 MarketplaceProductStatus @default(DRAFT)
  publishedAt            DateTime?
  /// Pricing-v3 marketplace de-emphasis: admin must physically test
  /// the product before it shows on the public catalogue. This flag
  /// is distinct from `status PUBLISHED` (which is editorial review
  /// of the listing copy/images) — it records that we have hands-on
  /// confirmation the product works as advertised. Public marketplace
  /// queries filter on `testedAndApprovedAt IS NOT NULL`. Set via
  /// `adminMarkProductTestedAction` (AdminScope.MARKETPLACE).
  testedAndApprovedAt    DateTime?
  variants               MarketplaceVariant[]
  reviews                MarketplaceReview[]
  vehicle                VehicleDetail?
  testedAndApprovedById  String?
  testedAndApprovedBy    User?                    @relation("MarketplaceProductTester", fields: [testedAndApprovedById], references: [id], onDelete: SetNull)
  /// Admin-block fields. Partner #1 — when admin temporarily blocks a
  /// listing, the row stays in DRAFT/PENDING_REVIEW/PUBLISHED but
  /// `blockedAt` is set so the storefront filter hides it. The reason
  /// is shown to the factory so they know how to remediate.
  blockedAt              DateTime?
  blockReason            String?
  viewsCount             Int                      @default(0)
  soldCount              Int                      @default(0)
  /// Buyer-side acompte share in basis points (3000 = 30%, 5000 = 50%).
  /// Mirrors `Quote.depositPercentageBps` so marketplace + sourcing share
  /// the same 30–50% policy (CTO audit F4). Default 3000 keeps existing
  /// listings on the 30 % split.
  depositPercentageBps   Int                      @default(3000)
  /// Delivery method (Incoterm) the factory commits to on this listing.
  /// Partner #15: previously the buyer picked the Incoterm at checkout,
  /// which let buyers select terms the factory couldn't honour. Now the
  /// factory locks it on the listing — buyers see it on the product
  /// page and the buy form treats it as fixed metadata. Default DAP
  /// (door-to-door) matches the v1 sourcing-flow default.
  incoterm               Incoterm                 @default(DAP)
  /// Partner #31: factory exposes a sample purchase. When true, the
  /// listing renders an "Order a sample" CTA that creates a single-
  /// unit Order at `samplePriceCentsClient` (typically higher per-unit
  /// than the bulk price because it includes air shipping). Null
  /// price + flag false = no sample available.
  sampleAvailable        Boolean                  @default(false)
  samplePriceCentsClient Int?
  /// Partner #5: AI-translated product copy. Map of locale → object
  /// with `{name, description, sourceLocale, generatedAt}`. Translated
  /// on demand via the Anthropic API (Claude Haiku) and cached here so
  /// repeat reads don't re-bill. Locale that the factory authored in
  /// is the `sourceLocale` and isn't stored under itself.
  translations           Json                     @default("{}")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([status, category])
  @@index([factoryOrgId, status])
  // Lets the storefront cheaply find listings whose flash sale ends soon —
  // used by the "ending soon" rail and any future flash-sale cron sweeps.
  @@index([flashSaleEndsAt])
}

// =============================================================
// FINANCE AGGREGATE
// =============================================================

model Invoice {
  id              String        @id @default(cuid(2))
  reference       String        @unique // INV-YYYY-NNNN
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type            InvoiceType
  amountCents     Int // TTC
  vatRateBps      Int           @default(2000) // 20.00% in basis points (1bp = 0.01%)
  issuedAt        DateTime
  dueAt           DateTime
  paidAt          DateTime?
  status          InvoiceStatus @default(DRAFT)
  pdfUrl          String?
  /// Partner round 4 — admin-issued invoices. Free-text line shown
  /// in the PDF + the buyer's list. Null for system-generated rows
  /// where the line comes from the order reference.
  lineDescription String?
  /// Partner round 4 — admin actor who created an ADMIN_CUSTOM
  /// invoice. Null for system-generated rows (DEPOSIT, BALANCE,
  /// RESEARCH_FEE etc.) where no human pushed the button.
  issuedByUserId  String?
  issuedBy        User?         @relation("InvoiceIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  escrow EscrowTransaction?

  @@index([organizationId, status])
  @@index([status, dueAt])
  @@index([type, issuedAt])
}

model EscrowTransaction {
  id             String                @id @default(cuid(2))
  reference      String                @unique // ESC-YYYY-NNNN
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoiceId      String                @unique
  invoice        Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents    Int
  status         EscrowStatus          @default(INITIATED)
  fundedAt       DateTime?
  releasedAt     DateTime?
  releaseTrigger EscrowReleaseTrigger?
  provider       String // "stripe_connect" | "bank_internal" | etc.
  providerRef    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  payout   Payout?
  disputes Dispute[]

  @@index([status, orderId])
  @@index([provider, providerRef])
}

/// What a payout is settling. Money leaves the platform for more than one
/// reason now, and they behave differently: an escrow release is gated on
/// delivery confirmation, freight is owed as soon as the buyer has paid the
/// carrier's invoice.
enum PayoutKind {
  /// Factory payout on delivery-confirmed escrow release.
  ESCROW_RELEASE
  /// Settlement to a shipper for an accepted freight quote. Never escrowed —
  /// we collect from the buyer and settle the carrier.
  FREIGHT
}

model Payout {
  id               String             @id @default(cuid(2))
  reference        String             @unique // PAY-YYYY-NNNN
  kind             PayoutKind         @default(ESCROW_RELEASE)
  /// Organisation being paid. Added 2026-08 when shippers became payees;
  /// `factoryOrgId` predates it and is retained because existing rows and
  /// finance reports reference it. For ESCROW_RELEASE the two are the same
  /// org — new code should read `payeeOrg`.
  payeeOrgId       String?
  payeeOrg         Organization?      @relation("PayoutPayeeOrg", fields: [payeeOrgId], references: [id], onDelete: Restrict)
  factoryOrgId     String
  factoryOrg       Organization       @relation(fields: [factoryOrgId], references: [id], onDelete: Restrict)
  /// Null for payouts that never pass through escrow — freight is collected
  /// from the buyer and settled straight to the carrier.
  escrowId         String?            @unique
  escrow           EscrowTransaction? @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  /// Set on FREIGHT payouts: the shipment being settled.
  shipmentId       String?            @unique
  shipment         Shipment?          @relation("ShipmentFreightPayout", fields: [shipmentId], references: [id], onDelete: SetNull)
  amountCents      Int // net paid to the factory (gross − supplier fee)
  /// 3% supplier-side fee retained by the platform on a payout. Renamed
  /// from `commissionCents` (CTO audit F3) because `Order.commissionCents`
  /// already means "total buyer-side platform margin" — two columns with
  /// the same name + different semantics was making finance reporting
  /// drift.
  supplierFeeCents Int
  method           PayoutMethod
  status           PayoutStatus       @default(PENDING)
  scheduledAt      DateTime?
  sentAt           DateTime?
  providerRef      String?
  failureReason    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([factoryOrgId, status])
  @@index([payeeOrgId, status])
  @@index([status, scheduledAt])
}

// =============================================================
// ANNEXE — Certification, Threads, Notifications, Audit, Tasks, Webhooks
// =============================================================

model Certification {
  id                 String              @id @default(cuid(2))
  reference          String              @unique // CERT-YYYY-NNN
  factoryOrgId       String
  factoryOrg         Organization        @relation("CertFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  /// @deprecated Partner #10 (2026-06-07) — buyer sponsorship feature
  /// retired because it wasn't landing with users. Column kept for
  /// historical rows; no UI sets it anymore. Drop in a future cleanup
  /// migration when we're sure nothing else reads it.
  sponsorClientOrgId String?
  sponsorClientOrg   Organization?       @relation("CertSponsorOrg", fields: [sponsorClientOrgId], references: [id], onDelete: SetNull)
  standard           String // e.g. "ISO 9001:2015"
  body               CertificationBody
  status             CertificationStatus @default(DOSSIER)
  progress           Int                 @default(0) // 0-100
  preAuditDate       DateTime?
  auditDate          DateTime?
  etaDate            DateTime?
  certificateUrl     String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([factoryOrgId, status])
  @@index([body, status])
}

model Thread {
  id            String            @id @default(cuid(2))
  contextType   ThreadContextType
  // Polymorphic — id of the SourcingRequest / Quote / Order / Certification / Organization (KYC) / Order (Dispute)
  contextId     String
  title         String?
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())

  participants ThreadParticipant[]
  messages     Message[]

  @@index([contextType, contextId])
  @@index([lastMessageAt])
}

// Many-to-many User <-> Thread with per-user unread tracking.
model ThreadParticipant {
  threadId    String
  thread      Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount Int       @default(0)
  joinedAt    DateTime  @default(now())
  lastReadAt  DateTime?

  @@id([threadId, userId])
  @@index([userId, unreadCount])
}

model Message {
  id           String    @id @default(cuid(2))
  threadId     String
  thread       Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String? // null for SYSTEM messages
  author       User?     @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String // markdown
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  // Attachments link via the polymorphic Attachment table
  // (contextType=MESSAGE, contextId=this.id) — no FK relation here.

  @@index([threadId, createdAt])
}

/**
 * Standalone support ticket — a thread between one requester (client /
 * factory / agent) and the admin/support team. The corresponding Thread
 * uses contextType=SUPPORT, contextId=this.id so every messaging feature
 * (attachments, voice notes, SSE, unread counts) works without forking
 * code.
 * Lifecycle:
 * - PENDING: created by the requester, no admin reply yet.
 * - OPEN: an admin has engaged, ticket is active.
 * - RESOLVED: admin closed it. A new requester message reopens it.
 * `topicKind` + `topicId` are polymorphic. Admin attaches one of the
 * supported entity types (order, marketplace product, organization,
 * agent, etc.) to give the conversation structure. The pair is plain
 * (no FK) so the topic survives when the upstream row is soft-deleted —
 * stale links are resolved + flagged in the UI.
 */
model SupportTicket {
  id              String              @id @default(cuid(2))
  reference       String              @unique // TKT-XXXXX
  subject         String
  status          SupportTicketStatus @default(PENDING)
  requesterUserId String
  requester       User                @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  requesterOrgId  String?
  requesterOrg    Organization?       @relation("SupportTicketRequesterOrg", fields: [requesterOrgId], references: [id], onDelete: SetNull)
  topicKind       SupportTopicKind?
  topicId         String?
  openedAt        DateTime?
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?               @relation("SupportTicketResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  guestConversations GuestConversation[] @relation("GuestChatTicket")

  @@index([status, createdAt])
  @@index([requesterUserId, status])
  @@index([topicKind, topicId])
}

model Notification {
  id              String           @id @default(cuid(2))
  recipientUserId String
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  description     String?
  contextType     String?
  contextId       String?
  read            Boolean          @default(false)
  readAt          DateTime?
  deliveredInapp  Boolean          @default(true)
  deliveredEmail  Boolean          @default(false)
  deliveredSms    Boolean          @default(false)
  /// When the daily-digest cron flushed this row in an email.
  /// Null means: either the recipient is on IMMEDIATE (the email was
  /// sent at emit time), they're on OFF (no email at all), or the
  /// digest cron hasn't picked it up yet.
  digestedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([recipientUserId, read, createdAt])
  @@index([type, createdAt])
  // Cron needs a fast lookup for "all non-digested, non-emailed rows
  // older than X for a given recipient". The composite index covers
  // both filter halves.
  @@index([recipientUserId, digestedAt, createdAt])
}

model AuditLog {
  id          String     @id @default(cuid(2))
  actorUserId String? // null for SYSTEM
  actor       User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String // e.g. "kyc.validated"
  targetType  String? // e.g. "Organization"
  targetId    String?
  payload     Json?
  ipAddress   String?
  userAgent   String?
  level       AuditLevel @default(INFO)
  createdAt   DateTime   @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([level, createdAt])
  @@index([action, createdAt])
}

model AgentTask {
  id          String            @id @default(cuid(2))
  agentId     String
  agent       User              @relation("TaskAgent", fields: [agentId], references: [id], onDelete: Cascade)
  requestId   String?
  request     SourcingRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  title       String
  description String?
  priority    AgentTaskPriority @default(MEDIUM)
  status      AgentTaskStatus   @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([agentId, status, dueAt])
}

// Operator-visible webhook log — supports the admin "substance" rule
// (every async system needs a status surface).
/**
 * Polymorphic attachment — images, videos, or files attached to any
 * context: messages, sourcing requests, orders, or marketplace listings.
 * Stored URL is whatever `storeFile()` returns (today: local disk, later:
 * S3 / R2). `mimeType` is what we sniffed at upload time; `kind` is the
 * coarse bucket used for grouping in the gallery UI (images grid, video
 * players, file links). We don't put attachments behind the existing
 * MarketplaceProduct.images String[] column because that one's already
 * load-bearing for the storefront card — keeping it lets the cards stay
 * fast (no extra join) while the polymorphic table picks up the new
 * surfaces.
 */
model Attachment {
  id           String            @id @default(cuid(2))
  contextType  AttachmentContext
  contextId    String
  uploaderId   String?
  uploader     User?             @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  kind         AttachmentKind
  storageUrl   String
  mimeType     String
  sizeBytes    Int
  originalName String
  createdAt    DateTime          @default(now())

  @@index([contextType, contextId])
}

/**
 * Admin-managed editorial banner shown on the marketplace storefront —
 * "Summer flash sale", "New African suppliers", etc. This is the
 * curation surface; individual factory flash-sales surface separately
 * via the listing-level compareAt/flashSaleEndsAt fields.
 * A banner is shown when `active` AND now is within the optional
 * [startsAt, endsAt] window. Ordered by `sortOrder` then `createdAt`.
 * Text + CTA + tone only (no image upload in v1) — keeps it dependency
 * free and lets the storefront render a styled gradient card.
 */
model MarketplaceBanner {
  id              String           @id @default(cuid(2))
  title           String
  subtitle        String?
  ctaLabel        String?
  ctaHref         String?
  tone            BannerTone       @default(BRAND)
  background      BannerBackground @default(PRESET)
  // GRADIENT config — hex colours + angle (degrees). `via` is optional.
  gradientFrom    String?
  gradientVia     String?
  gradientTo      String?
  gradientAngle   Int? // 0–360
  // IMAGE / VIDEO config — served path (via /api/attachments/<id>) + a
  // 0–100 dark overlay for text legibility.
  mediaUrl        String?
  overlayOpacity  Int              @default(40)
  active          Boolean          @default(true)
  sortOrder       Int              @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([active, sortOrder])
}

/**
 * Auction — factory-listed bulk lot or clearance stock that buyers bid
 * on within a time window. Distinct from MarketplaceProduct (fixed
 * price, ready stock) and SourcingRequest (custom-spec, agent-negotiated).
 * On settlement an Order is created at the winning bid price; the auction
 * commission curve is separate from 6%/3% — see docs/pricing-auctions.md.
 * v1 scaffold only — no UI yet. Schema in place so future builds can
 * reference the relations.
 */
model Auction {
  id                  String        @id @default(cuid(2))
  reference           String        @unique // AUC-XXX
  factoryOrgId        String
  factoryOrg          Organization  @relation("AuctionFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  title               String
  description         String
  category            Category
  images              String[]
  /// Lowest bid we accept — buyers must bid above this.
  startingBidCents    Int
  /// Optional reserve — when set, the auction only sells if the winning
  /// bid is at or above this. Null = no reserve, highest bid wins.
  reserveCents        Int?
  /// Optional buy-now price — bidder can skip the auction and buy
  /// immediately at this price. Null = no buy-now option.
  buyNowCents         Int?
  quantity            Int
  moq                 Int           @default(1)
  leadTimeDays        Int
  leadTimeUnit        LeadTimeUnit  @default(DAY)
  incoterm            Incoterm
  startsAt            DateTime
  endsAt              DateTime
  status              AuctionStatus @default(DRAFT)
  winnerBidId         String?       @unique
  winnerBid           Bid?          @relation("AuctionWinner", fields: [winnerBidId], references: [id])
  /// The Order materialised from this auction once it SOLD. Null while
  /// the auction is still running or ended without a winner. Used for
  /// idempotency — the settler refuses to materialise twice.
  materializedOrderId String?       @unique
  publishedAt         DateTime?
  rejectionReason     String?
  rejectedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  bids Bid[] @relation("AuctionBids")

  @@index([status, endsAt])
  @@index([factoryOrgId, status])
}

model Bid {
  id           String       @id @default(cuid(2))
  auctionId    String
  auction      Auction      @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)
  bidderOrgId  String
  bidderOrg    Organization @relation("BidderOrg", fields: [bidderOrgId], references: [id], onDelete: Restrict)
  bidderUserId String
  bidderUser   User         @relation("BidderUser", fields: [bidderUserId], references: [id], onDelete: Restrict)
  amountCents  Int
  status       BidStatus    @default(ACTIVE)
  createdAt    DateTime     @default(now())

  wonAuction Auction? @relation("AuctionWinner")

  @@index([auctionId, amountCents])
  @@index([bidderOrgId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid(2))
  source      WebhookSource
  eventType   String
  signature   String?
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  lastError   String?
  processedAt DateTime?
  receivedAt  DateTime      @default(now())

  @@index([source, status, receivedAt])
  @@index([eventType, receivedAt])
}

/**
 * Operator-controlled platform settings. Singleton row (id = "default").
 * Lets admins expand the geographic footprint (regions / countries
 * available in the new-request wizard, factory directory filters, etc.)
 * without a code change. Read everywhere via getSourcingAllowlist().
 * `allowedSourcingCountries` are ISO 3166-1 alpha-2 codes. A country can
 * be allowed without its parent region (lets ops onboard a single country
 * like UAE without unlocking the whole MIDDLE_EAST region).
 */
model PlatformSettings {
  id                       String           @id @default("default")
  allowedSourcingRegions   SourcingRegion[] @default([])
  allowedSourcingCountries String[]         @default([])
  /// Free-text estimated delivery windows shown on the marketplace per
  /// continent. Stored as strings (e.g. "20–35 jours") so the admin can
  /// express ranges or qualifiers without us baking units into the schema.
  /// Null = nothing displayed for that continent.
  deliveryEtaAfrica        String?
  deliveryEtaEurope        String?
  deliveryEtaAmericas      String?
  deliveryEtaAsia          String?
  updatedAt                DateTime         @updatedAt
}

/// GDPR right-to-erasure (Art. 17) request. Erasure is NOT self-serve in a
/// platform that holds financial/accounting records (legal-retention
/// exceptions under Art. 17(3)) — a user files a request, an admin reviews
/// it, and erasure (PII anonymisation + soft-delete) runs on approval.
/// One open (PENDING) request per user is enforced in the action layer.
model AccountDeletionRequest {
  id     String                @id @default(cuid(2))
  userId String
  user   User                  @relation("DeletionRequester", fields: [userId], references: [id], onDelete: Cascade)
  status DeletionRequestStatus @default(PENDING)
  /// Optional free-text reason supplied by the requester.
  reason String?

  /// Admin review trail.
  reviewedById String?
  reviewedBy   User?     @relation("DeletionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

enum DeletionRequestStatus {
  /// Awaiting admin review.
  PENDING
  /// User withdrew the request before review.
  CANCELLED
  /// Admin refused (e.g. active orders / accounting-retention obligation).
  REJECTED
  /// Admin approved AND erasure has been executed (PII anonymised, account
  /// soft-deleted). Terminal.
  COMPLETED
}

/// =============================================================
/// Expéditeur Sourcing Pick — logistics leg
///
/// Spec: "Documentation officielle – Rôle Expéditeur Sourcing Pick".
/// The shipper is a pure intermediary: it never contacts the end client
/// (§1.2). Everything below is exchanged between the internal team and the
/// shipper only; what reaches the client is decided by `ShipmentEvent.
/// clientVisible` (see the comment on that model).
/// =============================================================

/// The 10 official statuses (§4), in lifecycle order. Deliberately separate
/// from `OrderStatus`: that tracks the commercial order (payment, QC, buyer
/// receipt), this tracks the logistics leg, and the two advance independently.
enum ShipmentStatus {
  /// 1. Demande de devis reçue — shipper has all product + delivery data.
  QUOTE_REQUESTED
  /// 2. Devis en cours de calcul.
  QUOTE_CALCULATING
  /// 3. Devis validé (prix fixe) — confirmed and locked with a validity date.
  QUOTE_VALIDATED
  /// 4. Commande en préparation logistique.
  PREPARATION
  /// 5. Colis pris en charge par le transport.
  PICKED_UP
  /// 6. Colis en transit.
  IN_TRANSIT
  /// 7. Livraison en attente de finalisation.
  AWAITING_FINAL_DELIVERY
  /// 8. Livraison terminée.
  DELIVERED
  /// 9. Traitement incident en cours — delay, blockage, surcharge, customs.
  INCIDENT
  /// 10. Commande annulée.
  CANCELLED
}

/// One logistics leg per order. §2.2 allows one invoice to cover several
/// products, so the relation to Order is 1:1 and the per-product data lives
/// in ShipmentItem.
model Shipment {
  id           String        @id @default(cuid(2))
  reference    String        @unique // SHP-XXXXX
  orderId      String        @unique
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Assigned shipper org. Null between creation and assignment.
  shipperOrgId String?
  shipperOrg   Organization? @relation("ShipmentShipperOrg", fields: [shipperOrgId], references: [id], onDelete: SetNull)

  status ShipmentStatus @default(QUOTE_REQUESTED)

  // ---- §2.2 order-level data supplied by the internal team ----
  shippingMethod String // méthode d'expédition souhaitée par le client
  totalWeightKg  Decimal @db.Decimal(10, 3)
  lengthCm       Decimal @db.Decimal(10, 2)
  widthCm        Decimal @db.Decimal(10, 2)
  heightCm       Decimal @db.Decimal(10, 2)
  /// Full destination (§2.2.6). Denormalised rather than pointing at the
  /// client org: the delivery address can differ from the billing entity, and
  /// it must stay frozen as quoted even if the org later edits its address.
  destName       String
  destAddress    String
  destCity       String
  destPostalCode String
  destCountry    String

  /// The shipper's current fixed price. Set when they submit or revise —
  /// this is the shipper committing to a number, NOT the buyer agreeing to
  /// pay it. Buyer agreement is `buyerAcceptedQuoteId` below.
  acceptedQuoteId      String?        @unique
  /// ---- Buyer acceptance of the freight price ----
  ///
  /// Separate from the shipper's own quote because they are different acts by
  /// different parties. Billing someone for a number they never saw is how
  /// chargebacks start, so nothing is invoiced until this is set.
  buyerAcceptedQuoteId String?        @unique
  buyerAcceptedQuote   ShipmentQuote? @relation("ShipmentBuyerAcceptedQuote", fields: [buyerAcceptedQuoteId], references: [id], onDelete: SetNull)
  buyerAcceptedAt      DateTime?
  buyerDeclinedAt      DateTime?
  /// Why the buyer refused — the shipper needs it to revise sensibly.
  buyerDeclineReason   String?

  /// The conversion, frozen at the moment the buyer accepted.
  ///
  /// Shippers quote in CNY and buyers pay in EUR. Recomputing the rate later
  /// would mean invoicing a different number than the one they agreed to, so
  /// all three are stored: what was quoted, the rate used, and what we
  /// actually billed. An auditor can re-derive the arithmetic years later.
  quotedAmountCents    Int?
  quotedCurrency       String?
  /// Rate in basis points: EUR cents per 1 unit of quoted currency × 10 000.
  fxRateBps            Int?
  billedAmountCentsEur Int?
  shippingInvoiceId    String? @unique

  acceptedQuote ShipmentQuote? @relation("ShipmentAcceptedQuote", fields: [acceptedQuoteId], references: [id], onDelete: SetNull)

  /// §3.2 — set when the brief changes (weight, dimensions, method, address
  /// or composition) after a quote was accepted. The fixed price no longer
  /// applies and the shipper owes a justified revision. Cleared when a new
  /// quote is submitted.
  quoteStale Boolean @default(false)

  items  ShipmentItem[]
  quotes ShipmentQuote[] @relation("ShipmentQuotes")
  events ShipmentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freightPayout Payout? @relation("ShipmentFreightPayout")

  @@index([shipperOrgId, status])
  @@index([status, updatedAt])
}

/// §2.1 — per-product data. Prices are the goods' unit price (used for customs
/// valuation), NOT the logistics price.
model ShipmentItem {
  id             String   @id @default(cuid(2))
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  label          String
  /// Nature / type — "marchandise en usage libre" and similar declarations.
  nature         String
  quantity       Int      @default(1)
  unitPriceCents Int
  /// Stored relative path to the product image (§2.1.1).
  imageUrl       String?

  @@index([shipmentId])
}

/// §3 — every quote the shipper issues, kept as history rather than
/// overwritten. §3.2 obliges the shipper to re-price whenever weight,
/// dimensions, method, address or composition change, and §3.1/§3.3 oblige
/// them to state conditions and justify changes — so each revision carries its
/// own conditions, validity date and reason.
model ShipmentQuote {
  id             String   @id @default(cuid(2))
  shipmentId     String
  shipment       Shipment @relation("ShipmentQuotes", fields: [shipmentId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String   @default("CNY")
  /// §3.1 — the fixed price is only held until this date.
  validUntil     DateTime
  /// §3.1 — conditions applicable to the price.
  conditions     String
  /// §3.3 — special cases, surcharges, constraints.
  notes          String?
  /// §3.2 — why this revision differs from the previous one. Null on the first.
  revisionReason String?
  authorId       String?
  author         User?    @relation("ShipmentQuoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  acceptedFor        Shipment? @relation("ShipmentAcceptedQuote")
  acceptedByBuyerFor Shipment? @relation("ShipmentBuyerAcceptedQuote")

  @@index([shipmentId, createdAt])
}

/// Status history and the audit trail behind §5's 24h reporting duty.
model ShipmentEvent {
  id            String         @id @default(cuid(2))
  shipmentId    String
  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status        ShipmentStatus
  /// Free-text detail: incident description, justification, handover note.
  note          String?
  actorId       String?
  actor         User?          @relation("ShipmentEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Whether this event may surface on the CLIENT's order timeline.
  ///
  /// §1.2 forbids any contact between shipper and client, and §6.2 says the
  /// client only gets what the internal team passes on — but explicitly allows
  /// that to happen "manuellement/automatiquement via votre interface". So
  /// progress statuses mirror automatically under SourcingPick's own branding
  /// (never the shipper's identity, never a logistics price), while anything
  /// commercially sensitive — the quote steps, incidents, cancellations —
  /// defaults to false and waits for a human to relay it. See
  /// CLIENT_VISIBLE_STATUSES in lib/shipments/status.ts.
  clientVisible Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@index([shipmentId, createdAt])
}

/// =============================================================
/// Public live chat — logged-out visitors talking to the team.
///
/// Deliberately NOT modelled on Thread/ThreadParticipant. Those are keyed to
/// User rows, and a visitor has none; the alternatives were minting throwaway
/// User records (which would pollute the user table, the role enum and every
/// count/query that walks it) or making Thread.participants nullable (which
/// would weaken an invariant the whole messaging system relies on). A separate
/// pair of tables keeps the anonymous surface anonymous and leaves the
/// authenticated messaging model untouched.
///
/// Access is by unguessable token, the same pattern as the forwarder upload
/// link (`app/[lang]/forwarder/upload/[token]`). The widget keeps the token in
/// localStorage so a returning visitor sees their history.
/// =============================================================
/// Internal queue a public-chat conversation belongs to. Mirrors how the team
/// is actually organised rather than the AdminScope permission list — routing
/// is about who answers, not about who is allowed to.
enum GuestChatTeam {
  SALES
  SUPPORT
  ENGINEERING
  BILLING
  PARTNERSHIPS
  KYC
  LOGISTICS
}

enum GuestConversationStatus {
  OPEN
  /// Handed to a SupportTicket or a Dispute. The guest thread stays the
  /// visitor's channel; the internal work moves.
  ESCALATED
  CLOSED
}

/// Inbound email we have already ingested, keyed on the provider's Message-ID.
///
/// Webhooks retry: a slow response or a 500 means the same reply arrives two
/// or three times, and without this the customer's message appears three times
/// in the thread. The row is the dedupe key and nothing else — the message
/// itself lands in GuestMessage or Message.
model InboundEmail {
  id         String   @id @default(cuid(2))
  /// Provider Message-ID header. Unique index is the whole point of the table.
  messageId  String   @unique
  /// "g" (guest conversation) or "t" (support ticket), plus the target id —
  /// kept for tracing a mis-routed reply back to what it was addressed to.
  targetKind String
  targetId   String
  receivedAt DateTime @default(now())

  @@index([targetKind, targetId])
}

model GuestConversation {
  id        String                  @id @default(cuid(2))
  /// Unguessable; the visitor's only credential. Never displayed.
  token     String                  @unique
  name      String
  email     String
  /// Locale the visitor was browsing in, so replies go out in their language.
  locale    Locale                  @default(fr)
  /// Set when the team has read everything — drives the admin queue badge.
  handledAt DateTime?
  /// Queue that owns this conversation. Null until someone routes it, which is
  /// itself the signal for the unrouted inbox.
  team      GuestChatTeam?
  status    GuestConversationStatus @default(OPEN)
  closedAt  DateTime?

  /// Account matched to the visitor's email, if any. A public-chat visitor is
  /// anonymous, so this is the only bridge to anything that needs a real user
  /// — and it is what gates escalation rather than a fabricated placeholder.
  linkedUserId String?
  linkedUser   User?   @relation("GuestChatLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  /// Where the conversation was escalated to. SetNull rather than Cascade: a
  /// deleted ticket must not take the visitor transcript with it.
  escalatedTicketId  String?
  escalatedTicket    SupportTicket? @relation("GuestChatTicket", fields: [escalatedTicketId], references: [id], onDelete: SetNull)
  escalatedDisputeId String?
  escalatedDispute   Dispute?       @relation("GuestChatDispute", fields: [escalatedDisputeId], references: [id], onDelete: SetNull)
  escalatedAt        DateTime?
  /// SHA-256 of the client IP, salted with AUTH_SECRET. Stored hashed, never
  /// raw: this is an unauthenticated endpoint so it needs a rate-limit key,
  /// but a public contact form has no business retaining visitors' IPs. The
  /// hash is enough to count recent submissions and useless for anything else.
  ipHash             String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  messages GuestMessage[]

  @@index([handledAt, updatedAt])
  @@index([status, team, updatedAt])
}

model GuestMessage {
  id             String            @id @default(cuid(2))
  conversationId String
  conversation   GuestConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body           String
  /// True when written by the internal team. The visitor is never shown which
  /// staff member replied — the product promise is "the team", not a named
  /// person, so no author relation is stored at all.
  fromTeam       Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

/// =============================================================
/// 1688 INTEGRATION — REMOVABLE STUB
///
/// Deliberately isolated so it can be deleted without touching anything else.
/// See src/lib/integrations/vendor-1688/README.md for the removal checklist.
///
/// Note what is NOT here: no cached catalogue. Listings are proxied live from
/// the provider and never persisted, so there is nothing to go stale and
/// nothing of theirs stored. The only thing we keep is our own order record —
/// because we have to be able to answer "what did this buyer purchase, at what
/// price, and where is it" long after the listing has changed or vanished.
///
/// The org/user columns are plain Strings with NO relation to Organization or
/// User. That costs referential integrity and is a deliberate trade: a
/// relation would put a back-reference field on two core models, and removing
/// this integration would then mean editing them. Here, removal is dropping
/// two tables.
/// =============================================================

enum Vendor1688OrderStatus {
  /// Basket assembled on our side, nothing sent yet.
  DRAFT
  /// Handed to 1688 (or to the agent who places it there).
  SUBMITTED
  /// Supplier accepted and is producing/picking.
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  /// Submission failed — see failureReason. Distinct from CANCELLED, which is
  /// a decision rather than a fault.
  FAILED
}

model Vendor1688Order {
  id             String                @id @default(cuid(2))
  reference      String                @unique // V1688-XXXXX
  clientOrgId    String
  placedByUserId String?
  status         Vendor1688OrderStatus @default(DRAFT)

  /// The 1688 offer, snapshotted at order time. Since the catalogue is never
  /// cached, this is the only surviving record of what was bought — title,
  /// images, specs, supplier, as they were at purchase.
  offerSnapshot Json
  offerId       String
  offerUrl      String
  quantity      Int

  /// Money in CNY fen (1/100 yuan), integer — same convention as the rest of
  /// the app's *Cents fields.
  unitPriceFen Int
  subtotalFen  Int
  /// Markup stored as BOTH the rate applied and the resulting amount. Keeping
  /// only the rate would silently restate historical orders when the rate
  /// changes; keeping only the amount would make them unauditable.
  markupBps    Int
  markupFen    Int
  totalFen     Int

  /// Identifier returned by 1688 once the order exists on their side.
  vendorOrderId String?
  submittedAt   DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientOrgId, status])
  @@index([status, updatedAt])
}

/// =============================================================
/// Marketplace: variants, reviews, vehicles
/// =============================================================

/// A purchasable option within a listing — "Blue / XL", "2 m cable".
///
/// Optional by design: a product with no variants behaves exactly as it did
/// before, so nothing existing has to be migrated. When variants exist they
/// own stock, and price falls back to the product when not overridden — most
/// ranges are one price across every option, and repeating it per variant
/// invites the two drifting apart.
model MarketplaceVariant {
  id                String             @id @default(cuid(2))
  productId         String
  product           MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Factory's own code. Optional; nullable so several variants may have none
  /// (Postgres treats NULLs as distinct under the unique index below).
  sku               String?
  /// Display label, precomputed from `options` so lists don't rebuild it.
  label             String
  /// Ordered option pairs: [{ "name": "Colour", "value": "Blue" }, …].
  /// Json rather than a table: options are display-only here, never queried
  /// across products, and a normalised option/value pair of tables would be
  /// three joins to render one card.
  options           Json
  /// Null = inherit the product price. Set = override for this option.
  priceCentsClient  Int?
  priceCentsFactory Int?
  stockAvailable    Int                @default(0)
  imageUrl          String?
  position          Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[] @relation("OrderVariant")

  @@unique([productId, sku])
  @@index([productId, position])
}

enum ReviewStatus {
  /// Awaiting moderation. Reviews are never published unseen — one libellous
  /// or retaliatory review on a factory's listing is a legal problem.
  PENDING
  PUBLISHED
  REJECTED
}

/// A buyer's rating of a listing.
///
/// Attributed to the ORGANISATION, not the individual: the buyer relationship
/// is with the company, and one review per company per product stops a firm
/// stacking five accounts onto one listing.
model MarketplaceReview {
  id           String             @id @default(cuid(2))
  productId    String
  product      MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorOrgId  String
  authorOrg    Organization       @relation("ReviewAuthorOrg", fields: [authorOrgId], references: [id], onDelete: Cascade)
  authorUserId String?
  authorUser   User?              @relation("ReviewAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)

  /// 1–5. Range is enforced in the action, not the DB — Prisma has no check
  /// constraint, so the guard lives where the write happens.
  rating Int
  title  String?
  body   String

  /// The delivered order this review is tied to, when there is one. Its
  /// presence is what makes a review "verified purchase"; absence is allowed
  /// so a buyer who ordered off-platform can still be heard, clearly labelled.
  orderId String?
  order   Order?  @relation("ReviewOrder", fields: [orderId], references: [id], onDelete: SetNull)

  status         ReviewStatus @default(PENDING)
  moderatedById  String?
  moderatedAt    DateTime?
  /// Shown to the author when rejected, so moderation isn't a black hole.
  moderationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, authorOrgId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

enum VehicleFuel {
  PETROL
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
}

enum VehicleDrivetrain {
  FWD
  RWD
  AWD
}

/// Vehicle-specific fields, 1:1 with a Category.VEHICLE listing.
///
/// A separate table rather than nullable columns on MarketplaceProduct: these
/// are meaningless for the other nine categories, and eleven always-null
/// columns on every textile listing is a worse trade than one join on the few
/// listings that are cars.
model VehicleDetail {
  id        String             @id @default(cuid(2))
  productId String             @unique
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Unique per physical car. Optional because a NEW-car listing can be a
  /// build slot rather than a specific vehicle; required in practice for used
  /// ones, which the action enforces.
  vin          String?
  makeName     String
  modelName    String
  year         Int
  mileageKm    Int?
  fuel         VehicleFuel
  transmission VehicleTransmission
  drivetrain   VehicleDrivetrain?
  colour       String?
  /// Engine displacement in cc, and power in kW — kW rather than hp because
  /// it is what EU registration documents use.
  engineCc     Int?
  powerKw      Int?

  /// EU Certificate of Conformity. Without it an imported car cannot be
  /// registered in the EU, so this is a transaction blocker rather than a
  /// nice-to-have — surfaced prominently on the listing.
  hasCoc       Boolean @default(false)
  cocReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([makeName, modelName, year])
  @@index([vin])
}

/// What the visitor asked for on the public quote form (/devis).
enum QuoteRequestService {
  /// They already have suppliers; they need the goods moved.
  LOGISTICS
  /// They have no supplier yet and want one found first.
  SOURCING_LOGISTICS
}

enum QuoteRequestKind {
  BUSINESS
  INDIVIDUAL
}

enum QuoteRequestStatus {
  NEW
  IN_REVIEW
  ANSWERED
  /// Turned into a real SourcingRequest once the asker had an account.
  CONVERTED
  ARCHIVED
}

/// A quote asked for from the public site, by someone who has no account.
///
/// Deliberately not a SourcingRequest: that model requires a clientOrgId, and
/// a visitor has no organisation. This is the lead that precedes one — ops
/// answers it, and it converts once the asker signs up. Same shape of
/// unauthenticated intake as GuestConversation, down to the hashed IP.
///
/// Every measurement is free text because the form collects free text: the
/// canvas prompts "e.g. 12 m³ or 1,800 kg", so parsing it into a number would
/// be inventing precision the visitor never gave.
model QuoteRequest {
  id        String              @id @default(cuid(2))
  reference String              @unique
  service   QuoteRequestService
  status    QuoteRequestStatus  @default(NEW)

  // 2. Your goods
  products       String
  quantity       String?
  volume         String?
  goodsValue     String?
  supplierCount  String?
  supplierCities String?

  // 3. Destination
  destinationCountry String
  destinationCity    String?
  arrivalDate        String?

  // 4. Your details
  kind    QuoteRequestKind
  name    String
  company String?
  email   String
  phone   String?
  message String?

  /// The language the form was filled in, so the answer goes back in it.
  locale Locale @default(fr)

  /// An account matching the e-mail, if one exists. The bridge to converting
  /// this into a SourcingRequest without inventing an organisation.
  linkedUserId String?
  linkedUser   User?   @relation("QuoteRequestLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  /// Salted SHA-256 of the client IP — a rate-limit key, not a record of who
  /// visited. Same reasoning as GuestConversation.ipHash.
  ipHash String?

  handledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
