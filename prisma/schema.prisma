// SourcingPick database schema
//
// Models: 22 (17 from spec §3.1 + TenderInvitation, AgentTask, EmailOtp, WebhookEvent + Auth.js Account/Session/VerificationToken/ThreadParticipant)
// Enums:  18
//
// See docs/schema-design.md for rationale on every non-obvious decision.
// Prisma 7 note: connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// ENUMS
// =============================================================

enum Locale {
  fr
  en
  zh
  ar
}

enum Role {
  CLIENT
  FACTORY
  AGENT
  ADMIN
}

// Union of all sub-roles across all roles. Role/sub-role validity matrix is
// enforced in src/lib/permissions/, not in the DB.
enum SubRole {
  OWNER
  MEMBER
  ACCOUNTANT
  AGENT
  SENIOR
  SUPER
}

enum OrgType {
  CLIENT
  FACTORY
  // Internal SourcingPick org. Admin and Agent users belong to a PLATFORM org
  // so the User → Organization invariant holds without nullable FKs.
  PLATFORM
}

enum KycStatus {
  PENDING
  VERIFIED
  FLAGGED
  REJECTED
}

// Internal identifiers in English — UI labels come from i18n dictionaries.
enum Category {
  TEXTILE
  HOME
  STATIONERY
  COSMETICS
  FOOD
  ELECTRONICS
  METAL
  WOOD
  PLASTIC
  OTHER
}

// Coarse geographic regions for the sourcing filter. Kept Maghreb as
// distinct from sub-Saharan Africa to reflect real supply-chain patterns.
enum SourcingRegion {
  EUROPE
  MAGHREB
  AFRICA
  ASIA
  AMERICAS
  OCEANIA
  MIDDLE_EAST
  ANYWHERE
}

enum Incoterm {
  EXW
  FOB
  DAP
  DDP
  CIF
}

enum SourcingStatus {
  DRAFT
  REQUEST_RECEIVED
  ASSIGNED
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  /// Deprecated (CTO audit F6) — never written by the order→request
  /// mirror in src/lib/orders/actions.ts and never read elsewhere.
  /// Kept here only because PostgreSQL doesn't support dropping enum
  /// values without a full type recreate; a follow-up migration will
  /// rebuild the enum once we coordinate downtime.
  PAYMENT_PENDING
  PREPARATION
  SHIPPED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// Discriminator for SourcingRequest. SOURCING_FLOW is the agent-led
// procurement journey (client → agent → tender → quote → order).
// MARKETPLACE is the synthetic record we materialise for marketplace
// purchases so the Order/Invoice/Escrow pipeline can stay role-agnostic
// without ever pulling an agent into the loop. Agent assignment is
// explicitly blocked for MARKETPLACE rows.
enum SourcingRequestOrigin {
  SOURCING_FLOW
  MARKETPLACE
  /// Synthetic request materialised from a SOLD auction so the buyer
  /// can pay via the existing Wise wire flow on /client/orders/<id>.
  AUCTION
}

enum TenderInvitationStatus {
  INVITED
  VIEWED
  RESPONDED
  DECLINED
  EXPIRED
}

enum QuoteStatus {
  DRAFT
  SENT_TO_AGENT
  SENT_TO_CLIENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PAYMENT_PENDING
  PREPARATION
  QC
  SHIPPED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum MarketplaceProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  OUT_OF_STOCK
  ARCHIVED
}

enum MarketplaceCondition {
  NEW
  USED
  REFURBISHED
}

/// Display preference for production lead time on MarketplaceProduct. The
/// underlying `leadTimeDays` column always stores canonical DAYS (so order
/// ETAs, filters, and ranking stay simple) — this only controls how the
/// factory entered the value and how we render it back (e.g. 60 days → "2
/// months"). Conversion lives in src/lib/marketplace/lead-time.ts.
enum LeadTimeUnit {
  DAY
  MONTH
}

enum AttachmentContext {
  MESSAGE
  SOURCING_REQUEST
  ORDER
  MARKETPLACE_PRODUCT
  MARKETPLACE_BANNER
  /// Factory uploads while order is in QC — photos of the finished
  /// product, packed cartons, labels. Buyer can review before the
  /// factory ships.
  ORDER_QC_PROOF
  /// Factory uploads at handoff — photos of the package handed to the
  /// carrier with a visible tracking label. Closes the "did it ship?"
  /// ambiguity loop on disputes.
  ORDER_SHIPMENT_PROOF
}

/** Preset visual treatment for an admin-managed marketplace campaign banner. */
enum BannerTone {
  BRAND // brand-blue gradient
  DARK // ink-deep, matches the CTA banner
  SALE // danger/red accent for flash-sale campaigns
}

/**
 * How a banner's background is rendered.
 *   PRESET   — one of the BannerTone gradients (default, no config)
 *   GRADIENT — admin-defined linear gradient (from/via?/to + angle)
 *   IMAGE    — uploaded image, with a dark overlay for text legibility
 *   VIDEO    — uploaded muted-autoplay-loop video, with overlay
 */
enum BannerBackground {
  PRESET
  GRADIENT
  IMAGE
  VIDEO
}

/// Auction lifecycle. Factories can list bulk lots / clearance stock for
/// buyers to bid on; the highest bid at endsAt wins and an Order is
/// created at that price. Commission curve for auctions is separate from
/// the 6%/3% sourcing commission — see docs/pricing-auctions.md.
enum AuctionStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  ACTIVE
  ENDED
  SOLD
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WINNING
  REJECTED
}

enum AttachmentKind {
  IMAGE
  VIDEO
  /// Voice notes recorded in the messaging UI (partner feedback #9). Same
  /// storage path as other attachments; size cap lives in
  /// lib/storage/attachments.ts.
  AUDIO
  FILE
}

/**
 * Payout provider a factory or agent has onboarded with.
 *
 *   STRIPE_CONNECT — default for the EU/US/UK/SG/HK/UAE/MX/JP/AU/NZ
 *                   footprint plus parts of Africa (ZA, NG, KE, etc.).
 *   LIANLIAN       — cross-border payouts to mainland China + SE Asia.
 *   ALIPAY         — Alipay Cross-border / Ant International, also for
 *                   mainland China factories that prefer Alipay over
 *                   LianLian's bank-account flow.
 *
 * Locked once chosen (changing mid-relationship invalidates prior
 * payout audit references). Each provider has its own credential set
 * in env and its own KYC flow; see lib/payouts/* for adapters.
 */
/// Live rail = WISE only (decided 2026-06-02). The Stripe / LianLian /
/// Alipay values are deprecated (CTO audit F8) — no code path resolves
/// to them after the migration; we keep them in the enum because
/// PostgreSQL doesn't support `DROP VALUE` without recreating the type.
/// A follow-up migration will rebuild the enum once we coordinate the
/// requisite downtime / column rewrite.
enum PayoutProvider {
  /// @deprecated — Wise replaced this rail. Never written by current code.
  STRIPE_CONNECT
  /// @deprecated — Wise replaced this rail. Never written by current code.
  LIANLIAN
  /// @deprecated — Wise replaced this rail. Never written by current code.
  ALIPAY
  WISE
}

/**
 * Per-provider onboarding/account state on a factory or agent org. We
 * track this separately from Organization.kycStatus because payout
 * providers run their *own* KYB/AML — being verified by us doesn't
 * mean Stripe/LianLian/Alipay accepted the account.
 */
enum PayoutAccountStatus {
  NONE          // No provider chosen / no account opened
  PENDING       // Provider onboarding started, awaiting provider verification
  ACTIVE        // Account verified and can receive payouts
  RESTRICTED    // Provider returned a restriction (missing docs, suspended)
  REJECTED      // Provider permanently refused
}

enum InvoiceType {
  DEPOSIT
  BALANCE
  // Sourcing-flow research fee — billed per qualified request, credited back if order placed within 30 days.
  RESEARCH_FEE
  // Legacy from spec §1.1 (sourcing-side commission). Kept until commission wiring lands in Phase 3.
  SOURCING_FEE
  CERT_FEE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum EscrowStatus {
  INITIATED
  FUNDED
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum EscrowReleaseTrigger {
  DELIVERY_CONFIRMED
  ADMIN_OVERRIDE
  AUTO_TIMEOUT
}

/// Same deprecation as PayoutProvider — only WISE is written today.
/// SEPA / SWIFT remain valid (they're rail-method labels Wise can resolve
/// to under the hood). STRIPE_CONNECT / LIANLIAN / ALIPAY are dead.
enum PayoutMethod {
  SEPA
  SWIFT
  /// @deprecated — see PayoutProvider.
  STRIPE_CONNECT
  /// @deprecated — see PayoutProvider.
  LIANLIAN
  /// @deprecated — see PayoutProvider.
  ALIPAY
  WISE
}

/** Billing unit for the sourcing research fee (€125/day or €500/week). */
enum ResearchFeeUnit {
  DAY
  WEEK
}

/**
 * Why a CreditTransaction was written.
 *   RESEARCH_FEE_CREDIT — buyer ordered within the credit-back window; the
 *                         research fee they paid is returned as credit (+).
 *   ORDER_APPLIED       — credit spent against an order payment (−).
 *   ADMIN_ADJUSTMENT    — manual ops correction (±).
 */
enum CreditReason {
  RESEARCH_FEE_CREDIT
  ORDER_APPLIED
  ADMIN_ADJUSTMENT
}

/**
 * Lifecycle of a request's research fee.
 *   NONE     — no fee quoted yet
 *   QUOTED   — agent set the fee; an ISSUED invoice awaits payment
 *   PAID     — buyer paid the research fee
 *   CREDITED — buyer placed an order within the credit-back window; the fee
 *              was returned as platform credit (credit-back phase — TBD)
 *   WAIVED   — agent/admin waived the fee
 */
enum ResearchFeeStatus {
  NONE
  QUOTED
  PAID
  CREDITED
  WAIVED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  SENT
  RECEIVED
  FAILED
}

enum CertificationBody {
  BUREAU_VERITAS
  AFNOR
  SGS
  LNE
}

enum CertificationStatus {
  DOSSIER
  AUDIT_PROGRAMME
  EN_COURS
  CERTIFIE
  REFUSE
}

enum ThreadContextType {
  REQUEST
  TENDER
  QUOTE
  ORDER
  CERT
  KYC
  DISPUTE
  /// Direct conversation between two parties (e.g. a buyer and an agent)
  /// not anchored to any specific entity. Powers the standalone /messages
  /// tab — partner feedback #9. v1 scaffold; UI lands in a follow-up.
  DIRECT
  /// Support ticket — standalone thread between a requester (client,
  /// factory or agent) and the admin/support team. Linked to a
  /// `SupportTicket` row that carries status (PENDING/OPEN/RESOLVED) and
  /// an optional polymorphic topic (order, product, org, agent).
  SUPPORT
}

enum SupportTicketStatus {
  /// Created by the requester, no admin response yet.
  PENDING
  /// An admin has engaged or explicitly opened it.
  OPEN
  /// Admin marked it resolved. A new requester message reopens it.
  RESOLVED
}

/// Polymorphic anchor for a SupportTicket. The admin picks one of these
/// after the conversation starts to give the ticket structure (links to
/// the relevant order, listing, factory profile, etc.). `topicId` is the
/// id of the row in the corresponding table — left as a plain string so
/// the SupportTicket survives when an upstream row is soft-deleted.
enum SupportTopicKind {
  ORDER
  SOURCING_REQUEST
  MARKETPLACE_PRODUCT
  AUCTION
  /// Organization with type=CLIENT.
  CLIENT_ORG
  /// Organization with type=FACTORY.
  FACTORY_ORG
  /// User with role=AGENT.
  AGENT
}

enum NotificationType {
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  PAYMENT_RECEIVED
  SHIPMENT
  INVOICE_DUE
  CERT_UPDATE
  KYC_DECISION
  MESSAGE_MENTION
  SYSTEM
}

enum AuditLevel {
  INFO
  WARN
  ALERT
}

enum AgentTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum AgentTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WebhookSource {
  STRIPE
  /// Wise Business webhook deliveries — buyer wire credits + payout state
  /// transitions. Added 2026-06 (partner item #6) so the admin webhook
  /// dashboard surfaces unmatched / failed Wise reconciliations.
  WISE
  CARRIER
  OTHER
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  RETRYING
}

// KYC documents submitted by factories at signup. Reviewed by Admin in
// the KYC queue (admin/kyc).
enum KycDocumentKind {
  REGISTRY // Registre du commerce / business registration certificate (required per spec §10.1)
  TAX // Certificat fiscal / tax compliance certificate (required)
  FACILITY_PHOTO // Photo of installations (required, min. 3)
  REFERENCES // List of reference clients (recommended)
  INSURANCE // Quality assurance / liability insurance (recommended for risk categories)
  OTHER // Catch-all for misc supporting docs
}

// =============================================================
// ACCOUNT AGGREGATE — User, Auth.js tables, Organization, FactoryProfile
// =============================================================

model User {
  id String @id @default(cuid(2))

  // Auth.js v5 required shape
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Domain
  firstName        String
  lastName         String
  phone            String?
  locale           Locale       @default(fr)
  role             Role
  subRole          SubRole
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  passwordHash     String? // null when only OAuth
  hasOnboarded     Boolean      @default(false)
  twoFactorEnabled Boolean      @default(false)
  lastSeenAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Auth.js relations
  accounts  Account[]
  sessions  Session[]
  emailOtps EmailOtp[]

  attachments Attachment[]

  // Domain relations
  sourcingRequestsCreated SourcingRequest[]   @relation("RequestCreatedBy")
  agentForRequests        SourcingRequest[]   @relation("RequestAgent")
  preTenderApprovals      SourcingRequest[]   @relation("PreTenderApprover")
  forwarderTokensCreated  ForwarderUploadToken[] @relation("ForwarderTokenCreator")
  supportTicketsOpened    SupportTicket[]     @relation("SupportTicketRequester")
  supportTicketsResolved  SupportTicket[]     @relation("SupportTicketResolver")
  quotesAsAgent           Quote[]             @relation("QuoteAgent")
  ordersAsAgent           Order[]             @relation("OrderAgent")
  authoredMessages        Message[]           @relation("MessageAuthor")
  threadParticipations    ThreadParticipant[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  assignedTasks           AgentTask[]         @relation("TaskAgent")
  placedBids              Bid[]               @relation("BidderUser")

  @@index([organizationId])
  @@index([role, deletedAt])
}

// Auth.js — OAuth provider account links
model Account {
  id                String  @id @default(cuid(2))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js — DB session strategy
model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// Auth.js — used for password reset tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Our 2FA email-OTP records — not Auth.js
model EmailOtp {
  id         String    @id @default(cuid(2))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String // bcrypt of the 6-digit code
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Organization {
  id            String    @id @default(cuid(2))
  type          OrgType
  legalName     String
  displayName   String
  country       String
  city          String
  address       String
  vatNumber     String?
  siren         String? // FR only
  /// Stored relative path to the org's logo image (factories surface this
  /// on storefront/marketplace cards, clients on invoice headers). Null
  /// until the org uploads one — UI falls back to initials.
  logoUrl       String?
  kycStatus     KycStatus @default(PENDING)
  kycVerifiedAt DateTime?
  suspended     Boolean   @default(false)
  // Stripe identifiers — populated lazily on first checkout / first onboarding.
  // stripeCustomerId is used for clients (deposits + balance payments).
  // stripeConnectAccountId is used for factories (Connect Express payouts).
  stripeCustomerId       String?
  stripeConnectAccountId String?

  // Wise recipient account ID — the ID Wise issues after the platform
  // registers a factory's bank details via POST /v1/accounts. Used to
  // address payouts in `lib/payouts/wise.ts`. Null until the factory has
  // completed bank-details onboarding. Will replace the Stripe fields
  // above once the Wise migration retires Stripe.
  wiseRecipientId        String?

  // Payouts — which provider this org has chosen (factories + agents).
  // Locked once `payoutOnboardedAt` is set: changing provider mid-relationship
  // invalidates audit references on already-paid orders. The provider-specific
  // ID lives in `payoutAccountId` (Stripe acct_..., LianLian payee id, Alipay
  // login id) and is interpreted by the adapter in `lib/payouts/<provider>.ts`.
  payoutProvider     PayoutProvider?
  payoutAccountId    String?
  payoutStatus       PayoutAccountStatus @default(NONE)
  payoutOnboardedAt  DateTime?

  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  users          User[]
  factoryProfile FactoryProfile?

  clientSourcingRequests SourcingRequest[]  @relation("RequestClientOrg")
  factoryQuotes          Quote[]            @relation("QuoteFactoryOrg")
  factoryTenderInvites   TenderInvitation[] @relation("TenderFactoryOrg")

  clientOrders  Order[] @relation("OrderClientOrg")
  factoryOrders Order[] @relation("OrderFactoryOrg")

  factoryAuctions Auction[] @relation("AuctionFactoryOrg")
  bids            Bid[]     @relation("BidderOrg")

  marketplaceProducts MarketplaceProduct[]

  invoices Invoice[]
  payouts  Payout[]

  supportTicketsOpened SupportTicket[] @relation("SupportTicketRequesterOrg")

  factoryCertifications     Certification[] @relation("CertFactoryOrg")
  sponsorshipCertifications Certification[] @relation("CertSponsorOrg")

  kycDocuments KycDocument[]

  creditTransactions CreditTransaction[]

  @@index([type, kycStatus, deletedAt])
  @@index([type, country])
}

/**
 * Platform-credit ledger. An org's balance is the SUM of amountCents across
 * its rows (positive = credit granted, negative = credit spent). No
 * denormalised balance column — the ledger is the source of truth, summed
 * on read. Today's only credit source is the research-fee credit-back;
 * the only sink is applying credit to an order's deposit.
 */
model CreditTransaction {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountCents    Int // signed: + granted, − spent
  reason         CreditReason
  /// Optional pointer to what triggered it (e.g. "Order:ord_..", "SourcingRequest:req_..").
  refType        String?
  refId          String?
  note           String?
  createdByUserId String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model KycDocument {
  id             String          @id @default(cuid(2))
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           KycDocumentKind
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageUrl     String // for v1 local dev: relative path under ./uploads/; later: R2/S3 URL
  uploadedAt     DateTime        @default(now())

  @@index([organizationId, kind])
}

model FactoryProfile {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category
  foundedYear    Int?
  employees      Int?
  capabilities   String[]
  languages      String[]
  rating         Float        @default(0)
  totalOrders    Int          @default(0)
  iban           String? // encrypted at app layer
  bic            String?
  // High-level cert names for filtering; structured certs live in Certification
  certifications String[]

  @@index([category, rating])
}

// =============================================================
// SOURCING AGGREGATE
// =============================================================

model SourcingRequest {
  id                   String         @id @default(cuid(2))
  reference            String         @unique // REQ-XXXXXX
  clientOrgId          String
  clientOrg            Organization   @relation("RequestClientOrg", fields: [clientOrgId], references: [id], onDelete: Restrict)
  createdByUserId      String
  createdBy            User           @relation("RequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  agentId              String?
  agent                User?          @relation("RequestAgent", fields: [agentId], references: [id], onDelete: SetNull)
  title                String
  category             Category
  quantity             Int
  budgetCents          Int?
  targetUnitPriceCents Int?
  deadline             DateTime
  deliveryAddress      String
  incoterm             Incoterm
  sourcingRegion       SourcingRegion
  requiredCerts        String[]
  // ISO 3166-1 alpha-2 country code. Defaults to CN — China is the
  // current sole sourcing country, but the column is here so the admin
  // allowlist can expand the wizard's options without another migration.
  sourcingCountry      String                @default("CN")
  origin               SourcingRequestOrigin @default(SOURCING_FLOW)
  status               SourcingStatus        @default(DRAFT)
  assignedAt           DateTime?

  // Pre-tender validation gate (partner item #14). Agents cannot dispatch
  // TenderInvitations until an admin has approved the request, confirming
  // the brief is clear, the budget is sane, and the sourcing region is
  // allowed. A null `preTenderApprovedAt` is the block; rejection clears
  // approval and records the reason so the agent knows what to fix.
  preTenderApprovedAt      DateTime?
  preTenderApprovedById    String?
  preTenderApprovedBy      User?     @relation("PreTenderApprover", fields: [preTenderApprovedById], references: [id], onDelete: SetNull)
  preTenderRejectedAt      DateTime?
  preTenderRejectionReason String?

  // Research fee — agent quotes a per-day/week fee on a qualified request.
  // researchFeeInvoiceId links the issued RESEARCH_FEE invoice. Credit-back
  // (returning the fee as platform credit on order within 30 days) is a
  // later phase and not yet wired.
  researchFeeUnit      ResearchFeeUnit?
  researchFeeQuantity  Int?
  researchFeeCents     Int?
  researchFeeStatus    ResearchFeeStatus     @default(NONE)
  researchFeeInvoiceId String?
  researchFeePaidAt    DateTime? // anchors the 30-day credit-back window

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  products          SourcingProduct[]
  tenderInvitations TenderInvitation[]
  quotes            Quote[]
  orders            Order[]
  agentTasks        AgentTask[]

  @@index([status, agentId])
  @@index([clientOrgId, status])
  @@index([status, createdAt])
}

model SourcingProduct {
  id               String          @id @default(cuid(2))
  requestId        String
  request          SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  quantity         Int
  targetPriceCents Int?
  images           String[]

  @@index([requestId])
}

model TenderInvitation {
  id            String                 @id @default(cuid(2))
  requestId     String
  request       SourcingRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  factoryOrgId  String
  factoryOrg    Organization           @relation("TenderFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  matchingScore Int // 0-100
  status        TenderInvitationStatus @default(INVITED)
  invitedAt     DateTime               @default(now())
  viewedAt      DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime

  @@unique([requestId, factoryOrgId])
  @@index([factoryOrgId, status])
  @@index([requestId, status])
}

model Quote {
  id                    String          @id @default(cuid(2))
  requestId             String
  request               SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  factoryOrgId          String
  factoryOrg            Organization    @relation("QuoteFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  agentId               String?
  agent                 User?           @relation("QuoteAgent", fields: [agentId], references: [id], onDelete: SetNull)
  unitPriceCentsFactory Int // private to platform
  marginCents           Int // private to platform
  unitPriceCentsClient  Int
  totalCentsClient      Int
  quantity              Int
  leadTimeDays          Int
  /// Display unit for the lead time the factory entered. Storage stays
  /// canonical days; this drives how we render + how the form pre-fills
  /// on edit. Same shape as MarketplaceProduct.leadTimeUnit.
  leadTimeUnit          LeadTimeUnit    @default(DAY)
  moq                   Int
  incoterm              Incoterm
  validUntil            DateTime
  qualificationScore    Int // 0-100
  /// Deposit the factory wants up front, in basis points (3000=30%, 5000=50%).
  /// Range enforced in tender-actions.ts. Marketplace direct-buy quotes
  /// default to 3000 (30%) since there's no negotiation. Buyer pays this
  /// share via Wise on acceptance; balance settles at delivery.
  depositPercentageBps  Int             @default(3000)
  status                QuoteStatus     @default(DRAFT)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order Order?

  @@index([requestId, status])
  @@index([factoryOrgId, status])
  @@index([status, validUntil])
}

model Order {
  id              String          @id @default(cuid(2))
  reference       String          @unique // ORD-XXXXX
  quoteId         String          @unique
  quote           Quote           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  requestId       String
  request         SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  clientOrgId     String
  clientOrg       Organization    @relation("OrderClientOrg", fields: [clientOrgId], references: [id], onDelete: Restrict)
  factoryOrgId    String
  factoryOrg      Organization    @relation("OrderFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  agentId         String?
  agent           User?           @relation("OrderAgent", fields: [agentId], references: [id], onDelete: SetNull)
  totalCents      Int
  depositCents    Int // 30% default
  balanceCents    Int // 70% default
  commissionCents Int // platform margin — private
  status          OrderStatus     @default(PAYMENT_PENDING)
  estimatedEta    DateTime?
  shippedAt       DateTime?
  /// Set when the buyer confirms physical receipt of the goods. Separate
  /// from `balancePaidAt` — both must be set for COMPLETED to be reached
  /// (CTO audit F1b). When the buyer confirms before paying the balance,
  /// this is recorded but the status stays at SHIPPED / IN_TRANSIT until
  /// the balance settles.
  deliveredAt     DateTime?
  /// Set by the payment finaliser when the balance wire / charge has
  /// reconciled. Together with `deliveredAt`, gates the transition into
  /// COMPLETED + factory payout (CTO audit F1b / F1c). Buyer-initiated
  /// COMPLETED is blocked while this is null.
  balancePaidAt   DateTime?
  trackingNumber  String?
  trackingCarrier String?
  trackingUrl     String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  invoices         Invoice[]
  escrows          EscrowTransaction[]
  forwarderTokens  ForwarderUploadToken[]

  @@index([status, factoryOrgId])
  @@index([status, clientOrgId])
  @@index([status, createdAt])
}

/**
 * Magic-link token (partner item #15) — a factory generates one of these
 * for an Order and shares the resulting URL with its forwarder/logistics
 * partner. The forwarder lands on /forwarder/upload/<token>, sees the
 * order summary (no SourcingPick account required) and uploads handoff
 * photos that land as ORDER_SHIPMENT_PROOF attachments.
 *
 * Tokens are one-use-per-upload but live for `expiresAt`, so the
 * forwarder can come back to add more photos in the same window. Set
 * `revokedAt` to kill access early. `lastUsedAt` is bumped on every
 * successful upload for the operator log.
 */
model ForwarderUploadToken {
  id              String    @id @default(cuid(2))
  token           String    @unique // 32 hex chars — used in the magic URL
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?     @relation("ForwarderTokenCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Free-text label the factory chose ("DHL pickup", "Maersk container"). Surfaced to the forwarder.
  label           String?
  expiresAt       DateTime
  lastUsedAt      DateTime?
  uploadCount     Int       @default(0)
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([orderId, revokedAt])
  @@index([expiresAt])
}

// =============================================================
// CATALOGUE AGGREGATE
// =============================================================

model MarketplaceProduct {
  id                String                   @id @default(cuid(2))
  reference         String                   @unique // MKT-XXX
  factoryOrgId      String
  factoryOrg        Organization             @relation(fields: [factoryOrgId], references: [id], onDelete: Restrict)
  name              String
  category          Category
  description       String
  images            String[]
  priceCentsClient  Int
  priceCentsFactory Int // private
  /// Optional "was" price for strikethrough display. When set and greater
  /// than priceCentsClient, the storefront renders a discount badge.
  /// Independent of flashSaleEndsAt — used for permanent discounts on
  /// used / refurbished / clearance items.
  compareAtCents    Int?
  /// Optional flash-sale end timestamp. When in the future, the storefront
  /// renders a flash-sale badge with a countdown alongside the discount.
  /// After this passes, the listing keeps its discounted price but the
  /// urgency badge disappears — factory must update the listing to revert.
  flashSaleEndsAt   DateTime?
  condition         MarketplaceCondition     @default(NEW)
  moq               Int
  stockAvailable    Int                      @default(0)
  stockLowThreshold Int?
  /// Canonical lead time in DAYS — used by order ETAs, filters, ranking.
  /// The factory may have entered it in months via the UI; conversion to
  /// days happens at submit (see lib/marketplace/lead-time.ts).
  leadTimeDays      Int
  /// Display preference (DAY | MONTH). Drives the input unit on edit and
  /// the formatted output on product pages.
  leadTimeUnit      LeadTimeUnit             @default(DAY)
  certifications    String[]
  status            MarketplaceProductStatus @default(DRAFT)
  publishedAt       DateTime?
  viewsCount        Int                      @default(0)
  soldCount         Int                      @default(0)
  /// Buyer-side acompte share in basis points (3000 = 30%, 5000 = 50%).
  /// Mirrors `Quote.depositPercentageBps` so marketplace + sourcing share
  /// the same 30–50% policy (CTO audit F4). Default 3000 keeps existing
  /// listings on the 30 % split.
  depositPercentageBps Int                   @default(3000)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([status, category])
  @@index([factoryOrgId, status])
  // Lets the storefront cheaply find listings whose flash sale ends soon —
  // used by the "ending soon" rail and any future flash-sale cron sweeps.
  @@index([flashSaleEndsAt])
}

// =============================================================
// FINANCE AGGREGATE
// =============================================================

model Invoice {
  id             String        @id @default(cuid(2))
  reference      String        @unique // INV-YYYY-NNNN
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type           InvoiceType
  amountCents    Int // TTC
  vatRateBps     Int           @default(2000) // 20.00% in basis points (1bp = 0.01%)
  issuedAt       DateTime
  dueAt          DateTime
  paidAt         DateTime?
  status         InvoiceStatus @default(DRAFT)
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  escrow EscrowTransaction?

  @@index([organizationId, status])
  @@index([status, dueAt])
  @@index([type, issuedAt])
}

model EscrowTransaction {
  id             String                @id @default(cuid(2))
  reference      String                @unique // ESC-YYYY-NNNN
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoiceId      String                @unique
  invoice        Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents    Int
  status         EscrowStatus          @default(INITIATED)
  fundedAt       DateTime?
  releasedAt     DateTime?
  releaseTrigger EscrowReleaseTrigger?
  provider       String // "stripe_connect" | "bank_internal" | etc.
  providerRef    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  payout Payout?

  @@index([status, orderId])
  @@index([provider, providerRef])
}

model Payout {
  id              String            @id @default(cuid(2))
  reference       String            @unique // PAY-YYYY-NNNN
  factoryOrgId    String
  factoryOrg      Organization      @relation(fields: [factoryOrgId], references: [id], onDelete: Restrict)
  escrowId        String            @unique
  escrow          EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  amountCents     Int // net paid to the factory (gross − supplier fee)
  /// 3% supplier-side fee retained by the platform on a payout. Renamed
  /// from `commissionCents` (CTO audit F3) because `Order.commissionCents`
  /// already means "total buyer-side platform margin" — two columns with
  /// the same name + different semantics was making finance reporting
  /// drift.
  supplierFeeCents Int
  method          PayoutMethod
  status          PayoutStatus      @default(PENDING)
  scheduledAt     DateTime?
  sentAt          DateTime?
  providerRef     String?
  failureReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([factoryOrgId, status])
  @@index([status, scheduledAt])
}

// =============================================================
// ANNEXE — Certification, Threads, Notifications, Audit, Tasks, Webhooks
// =============================================================

model Certification {
  id                 String              @id @default(cuid(2))
  reference          String              @unique // CERT-YYYY-NNN
  factoryOrgId       String
  factoryOrg         Organization        @relation("CertFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  sponsorClientOrgId String?
  sponsorClientOrg   Organization?       @relation("CertSponsorOrg", fields: [sponsorClientOrgId], references: [id], onDelete: SetNull)
  standard           String // e.g. "ISO 9001:2015"
  body               CertificationBody
  status             CertificationStatus @default(DOSSIER)
  progress           Int                 @default(0) // 0-100
  preAuditDate       DateTime?
  auditDate          DateTime?
  etaDate            DateTime?
  certificateUrl     String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([factoryOrgId, status])
  @@index([body, status])
}

model Thread {
  id            String            @id @default(cuid(2))
  contextType   ThreadContextType
  // Polymorphic — id of the SourcingRequest / Quote / Order / Certification / Organization (KYC) / Order (Dispute)
  contextId     String
  title         String?
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())

  participants ThreadParticipant[]
  messages     Message[]

  @@index([contextType, contextId])
  @@index([lastMessageAt])
}

// Many-to-many User <-> Thread with per-user unread tracking.
model ThreadParticipant {
  threadId    String
  thread      Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount Int       @default(0)
  joinedAt    DateTime  @default(now())
  lastReadAt  DateTime?

  @@id([threadId, userId])
  @@index([userId, unreadCount])
}

model Message {
  id           String    @id @default(cuid(2))
  threadId     String
  thread       Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String? // null for SYSTEM messages
  author       User?     @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String // markdown
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  // Attachments link via the polymorphic Attachment table
  // (contextType=MESSAGE, contextId=this.id) — no FK relation here.

  @@index([threadId, createdAt])
}

/**
 * Standalone support ticket — a thread between one requester (client /
 * factory / agent) and the admin/support team. The corresponding Thread
 * uses contextType=SUPPORT, contextId=this.id so every messaging feature
 * (attachments, voice notes, SSE, unread counts) works without forking
 * code.
 *
 * Lifecycle:
 *   - PENDING: created by the requester, no admin reply yet.
 *   - OPEN: an admin has engaged, ticket is active.
 *   - RESOLVED: admin closed it. A new requester message reopens it.
 *
 * `topicKind` + `topicId` are polymorphic. Admin attaches one of the
 * supported entity types (order, marketplace product, organization,
 * agent, etc.) to give the conversation structure. The pair is plain
 * (no FK) so the topic survives when the upstream row is soft-deleted —
 * stale links are resolved + flagged in the UI.
 */
model SupportTicket {
  id               String              @id @default(cuid(2))
  reference        String              @unique // TKT-XXXXX
  subject          String
  status           SupportTicketStatus @default(PENDING)
  requesterUserId  String
  requester        User                @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  requesterOrgId   String?
  requesterOrg     Organization?       @relation("SupportTicketRequesterOrg", fields: [requesterOrgId], references: [id], onDelete: SetNull)
  topicKind        SupportTopicKind?
  topicId          String?
  openedAt         DateTime?
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?               @relation("SupportTicketResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([requesterUserId, status])
  @@index([topicKind, topicId])
}

model Notification {
  id              String           @id @default(cuid(2))
  recipientUserId String
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  description     String?
  contextType     String?
  contextId       String?
  read            Boolean          @default(false)
  readAt          DateTime?
  deliveredInapp  Boolean          @default(true)
  deliveredEmail  Boolean          @default(false)
  deliveredSms    Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([recipientUserId, read, createdAt])
  @@index([type, createdAt])
}

model AuditLog {
  id          String     @id @default(cuid(2))
  actorUserId String? // null for SYSTEM
  actor       User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String // e.g. "kyc.validated"
  targetType  String? // e.g. "Organization"
  targetId    String?
  payload     Json?
  ipAddress   String?
  userAgent   String?
  level       AuditLevel @default(INFO)
  createdAt   DateTime   @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([level, createdAt])
  @@index([action, createdAt])
}

model AgentTask {
  id          String            @id @default(cuid(2))
  agentId     String
  agent       User              @relation("TaskAgent", fields: [agentId], references: [id], onDelete: Cascade)
  requestId   String?
  request     SourcingRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  title       String
  description String?
  priority    AgentTaskPriority @default(MEDIUM)
  status      AgentTaskStatus   @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([agentId, status, dueAt])
}

// Operator-visible webhook log — supports the admin "substance" rule
// (every async system needs a status surface).
/**
 * Polymorphic attachment — images, videos, or files attached to any
 * context: messages, sourcing requests, orders, or marketplace listings.
 *
 * Stored URL is whatever `storeFile()` returns (today: local disk, later:
 * S3 / R2). `mimeType` is what we sniffed at upload time; `kind` is the
 * coarse bucket used for grouping in the gallery UI (images grid, video
 * players, file links). We don't put attachments behind the existing
 * MarketplaceProduct.images String[] column because that one's already
 * load-bearing for the storefront card — keeping it lets the cards stay
 * fast (no extra join) while the polymorphic table picks up the new
 * surfaces.
 */
model Attachment {
  id           String            @id @default(cuid(2))
  contextType  AttachmentContext
  contextId    String
  uploaderId   String?
  uploader     User?             @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  kind         AttachmentKind
  storageUrl   String
  mimeType     String
  sizeBytes    Int
  originalName String
  createdAt    DateTime          @default(now())

  @@index([contextType, contextId])
}

/**
 * Admin-managed editorial banner shown on the marketplace storefront —
 * "Summer flash sale", "New African suppliers", etc. This is the
 * curation surface; individual factory flash-sales surface separately
 * via the listing-level compareAt/flashSaleEndsAt fields.
 *
 * A banner is shown when `active` AND now is within the optional
 * [startsAt, endsAt] window. Ordered by `sortOrder` then `createdAt`.
 * Text + CTA + tone only (no image upload in v1) — keeps it dependency
 * free and lets the storefront render a styled gradient card.
 */
model MarketplaceBanner {
  id              String           @id @default(cuid(2))
  title           String
  subtitle        String?
  ctaLabel        String?
  ctaHref         String?
  tone            BannerTone       @default(BRAND)
  background      BannerBackground @default(PRESET)
  // GRADIENT config — hex colours + angle (degrees). `via` is optional.
  gradientFrom    String?
  gradientVia     String?
  gradientTo      String?
  gradientAngle   Int? // 0–360
  // IMAGE / VIDEO config — served path (via /api/attachments/<id>) + a
  // 0–100 dark overlay for text legibility.
  mediaUrl        String?
  overlayOpacity  Int              @default(40)
  active          Boolean          @default(true)
  sortOrder       Int              @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([active, sortOrder])
}

/**
 * Auction — factory-listed bulk lot or clearance stock that buyers bid
 * on within a time window. Distinct from MarketplaceProduct (fixed
 * price, ready stock) and SourcingRequest (custom-spec, agent-negotiated).
 * On settlement an Order is created at the winning bid price; the auction
 * commission curve is separate from 6%/3% — see docs/pricing-auctions.md.
 *
 * v1 scaffold only — no UI yet. Schema in place so future builds can
 * reference the relations.
 */
model Auction {
  id                String        @id @default(cuid(2))
  reference         String        @unique // AUC-XXX
  factoryOrgId      String
  factoryOrg        Organization  @relation("AuctionFactoryOrg", fields: [factoryOrgId], references: [id], onDelete: Restrict)
  title             String
  description       String
  category          Category
  images            String[]
  /// Lowest bid we accept — buyers must bid above this.
  startingBidCents  Int
  /// Optional reserve — when set, the auction only sells if the winning
  /// bid is at or above this. Null = no reserve, highest bid wins.
  reserveCents      Int?
  /// Optional buy-now price — bidder can skip the auction and buy
  /// immediately at this price. Null = no buy-now option.
  buyNowCents       Int?
  quantity          Int
  moq               Int           @default(1)
  leadTimeDays      Int
  leadTimeUnit      LeadTimeUnit  @default(DAY)
  incoterm          Incoterm
  startsAt          DateTime
  endsAt            DateTime
  status            AuctionStatus @default(DRAFT)
  winnerBidId       String?       @unique
  winnerBid         Bid?          @relation("AuctionWinner", fields: [winnerBidId], references: [id])
  /// The Order materialised from this auction once it SOLD. Null while
  /// the auction is still running or ended without a winner. Used for
  /// idempotency — the settler refuses to materialise twice.
  materializedOrderId String?     @unique
  publishedAt       DateTime?
  rejectionReason   String?
  rejectedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bids Bid[] @relation("AuctionBids")

  @@index([status, endsAt])
  @@index([factoryOrgId, status])
}

model Bid {
  id            String       @id @default(cuid(2))
  auctionId     String
  auction       Auction      @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)
  bidderOrgId   String
  bidderOrg     Organization @relation("BidderOrg", fields: [bidderOrgId], references: [id], onDelete: Restrict)
  bidderUserId  String
  bidderUser    User         @relation("BidderUser", fields: [bidderUserId], references: [id], onDelete: Restrict)
  amountCents   Int
  status        BidStatus    @default(ACTIVE)
  createdAt     DateTime     @default(now())

  wonAuction Auction? @relation("AuctionWinner")

  @@index([auctionId, amountCents])
  @@index([bidderOrgId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid(2))
  source      WebhookSource
  eventType   String
  signature   String?
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  lastError   String?
  processedAt DateTime?
  receivedAt  DateTime      @default(now())

  @@index([source, status, receivedAt])
  @@index([eventType, receivedAt])
}

/**
 * Operator-controlled platform settings. Singleton row (id = "default").
 *
 * Lets admins expand the geographic footprint (regions / countries
 * available in the new-request wizard, factory directory filters, etc.)
 * without a code change. Read everywhere via getSourcingAllowlist().
 *
 * `allowedSourcingCountries` are ISO 3166-1 alpha-2 codes. A country can
 * be allowed without its parent region (lets ops onboard a single country
 * like UAE without unlocking the whole MIDDLE_EAST region).
 */
model PlatformSettings {
  id                       String           @id @default("default")
  allowedSourcingRegions   SourcingRegion[] @default([])
  allowedSourcingCountries String[]         @default([])
  /// Free-text estimated delivery windows shown on the marketplace per
  /// continent. Stored as strings (e.g. "20–35 jours") so the admin can
  /// express ranges or qualifiers without us baking units into the schema.
  /// Null = nothing displayed for that continent.
  deliveryEtaAfrica        String?
  deliveryEtaEurope        String?
  deliveryEtaAmericas      String?
  deliveryEtaAsia          String?
  updatedAt                DateTime         @updatedAt
}
